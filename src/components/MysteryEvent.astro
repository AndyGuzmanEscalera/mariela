---
/**
 * MysteryEvent
 * -------------
 * Sección genérica de "Próximo Detalle Especial" — un lugar
 * misterioso para guardar una sorpresa sin revelar fecha.
 * Al hacer clic en el botón se abre un modal cariñoso.
 */
---

<section id="misterio" class="relative py-24 md:py-32 px-5">
  <div class="max-w-5xl mx-auto reveal">
    <div class="text-center mb-14">
      <p class="font-script text-3xl text-butter-700 mb-2">Algo viene...</p>
      <h2 class="section-title">Próximo Detalle Especial 🎁✨</h2>
      <p class="section-subtitle">
        Hay algo mágico preparándose para ti, Mariela.
      </p>
    </div>

    <!-- Mystery card -->
    <div class="relative mx-auto max-w-3xl">
      <div class="relative glass-card overflow-hidden p-8 md:p-12">
        <div class="grid md:grid-cols-2 gap-10 items-center">
          <!-- Texto -->
          <div>
            <p class="stamp mb-4">Próximamente</p>
            <h3 class="font-serif text-3xl md:text-4xl text-butter-900 mb-3 leading-tight">
              Una sorpresa está en camino...
            </h3>
            <p class="text-butter-800/80 text-lg leading-relaxed">
              Cada detalle se está eligiendo con muchísimo cariño,
              pensando siempre en tu sonrisa.
            </p>

            <div class="mt-8 flex flex-col items-start gap-3">
              <button
                id="reveal-btn"
                type="button"
                class="btn-primary"
              >
                <span>¿Quieres una pista?</span>
                <span class="text-xl">🔒</span>
              </button>
              <p class="text-xs text-butter-700/70 italic">
                Pista: tiene que ver contigo, con flores… y con algo que jamás olvidarás.
              </p>
            </div>
          </div>

          <!-- Caja de regalo animada -->
          <div class="relative flex justify-center">
            <div class="relative">
              <div class="absolute inset-0 bg-butter-500/30 blur-3xl rounded-full"></div>
              <svg
                class="relative w-56 h-56 animate-float-slow"
                viewBox="0 0 200 200"
                aria-hidden="true"
              >
                <defs>
                  <linearGradient id="boxGold" x1="0" x2="1" y1="0" y2="1">
                    <stop offset="0%" stop-color="#FFE39E" />
                    <stop offset="100%" stop-color="#F5B028" />
                  </linearGradient>
                </defs>
                <rect x="40" y="80" width="120" height="90" rx="8" fill="url(#boxGold)" stroke="#A56B0E" stroke-width="2"/>
                <rect x="35" y="70" width="130" height="20" rx="4" fill="#FFD466" stroke="#A56B0E" stroke-width="2"/>
                <rect x="92" y="70" width="16" height="100" fill="#E0A526" stroke="#A56B0E" stroke-width="1.5"/>
                <path d="M100 70 C 70 30, 70 30, 100 50 C 130 30, 130 30, 100 70 Z" fill="#F5B028" stroke="#A56B0E" stroke-width="1.5"/>
                <g fill="#FFE39E">
                  <circle cx="30" cy="40" r="3"/>
                  <circle cx="170" cy="50" r="3"/>
                  <circle cx="20" cy="120" r="2"/>
                  <circle cx="180" cy="130" r="2"/>
                  <circle cx="160" cy="170" r="2.5"/>
                  <circle cx="40" cy="170" r="2"/>
                </g>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal -->
  <div
    id="mystery-modal"
    class="fixed inset-0 z-[60] hidden items-center justify-center p-4 bg-butter-900/60 backdrop-blur-md"
    role="dialog"
    aria-modal="true"
    aria-labelledby="mystery-modal-title"
  >
    <div class="relative max-w-lg w-full">
      <div class="absolute inset-0 -m-3 bg-butter-500/20 blur-3xl rounded-full"></div>

      <div class="relative glass-card border-2 border-butter-500/60 overflow-hidden">
        <div class="bg-gradient-to-r from-butter-600 via-butter-500 to-sunset-gold px-6 py-3 flex items-center justify-between">
          <span class="text-white font-semibold uppercase tracking-[0.25em] text-xs flex items-center gap-2">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2a5 5 0 00-5 5v3H6a2 2 0 00-2 2v9a2 2 0 002 2h12a2 2 0 002-2v-9a2 2 0 00-2-2h-1V7a5 5 0 00-5-5zm-3 8V7a3 3 0 116 0v3H9z"/>
            </svg>
            Sistema de Seguridad
          </span>
          <button
            id="close-modal"
            type="button"
            class="text-white/90 hover:text-white transition"
            aria-label="Cerrar modal"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.4" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M6 18L18 6" />
            </svg>
          </button>
        </div>

        <div class="p-8 text-center">
          <div class="relative mx-auto mb-5 w-24 h-24">
            <div class="absolute inset-0 bg-butter-500/30 blur-2xl rounded-full animate-pulse-soft"></div>
            <div class="relative w-24 h-24 rounded-full bg-gradient-to-br from-butter-300 to-sunset-gold flex items-center justify-center shadow-glow">
              <span class="text-5xl">🔒</span>
            </div>
          </div>

          <h3 id="mystery-modal-title" class="font-serif text-3xl text-butter-900 mb-2">
            ¡Acceso Denegado!
          </h3>
          <p class="font-script text-3xl text-butter-700 mb-4">por el momento</p>

          <p class="text-butter-800/85 leading-relaxed text-base md:text-lg">
            Esta sorpresa se está preparando con
            <span class="font-semibold text-butter-700">muchísimo amor</span>.
            <br />
            <span class="block mt-2">
              Vuelve muy pronto para descubrirla, Mariela. 💛
            </span>
          </p>

          <button
            id="close-modal-2"
            type="button"
            class="btn-ghost mt-7"
          >
            Entendido, esperaré con ilusión ✨
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // ---------- Modal ----------
  const modal = document.getElementById('mystery-modal');
  const revealBtn = document.getElementById('reveal-btn');
  const closeBtns = [document.getElementById('close-modal'), document.getElementById('close-modal-2')];

  const openModal = () => {
    if (!modal) return;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  };

  const closeModal = () => {
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  };

  revealBtn?.addEventListener('click', openModal);
  closeBtns.forEach((btn) => btn?.addEventListener('click', closeModal));

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });
</script>
