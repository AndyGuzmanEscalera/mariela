---
/**
 * /juego4 — Defensa Lateral 2D
 * ----------------------------------------------
 * Mariela camina hacia la derecha derrotando minions
 * y al final destruye la Torre del Infiltrado. Click
 * para disparar flechas, evita que los minions te toquen.
 *
 * Resultado se guarda en el repo (vía Worker).
 */
---

<!doctype html>
<html lang="es" data-base-url={import.meta.env.BASE_URL}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5" />
    <meta name="theme-color" content="#1A0F2E" />
    <title>Defensa de Mariela ⚔️</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="defense-body">
    <div class="magic-dust" aria-hidden="true">
      {Array.from({ length: 30 }).map((_, i) => (
        <span
          class="dust"
          style={`top:${Math.random() * 100}%; left:${Math.random() * 100}%; animation-delay:${Math.random() * 5}s;`}
        ></span>
      ))}
    </div>

    <main class="relative z-10 min-h-screen flex items-center justify-center px-4 py-6">
      <div class="defense-frame">

        {/* ============ PANTALLA 1: Bienvenida ============ */}
        <section id="screen-welcome" class="screen screen-active">
          <div class="welcome-badge">
            <span>🎮</span>
            <span>2D Defense</span>
          </div>
          <h1 class="defense-title">Defensa de Mariela</h1>
          <p class="defense-subtitle">
            Caminá hacia adelante, dispará a los minions
            <br />y destruí la <strong>Torre del Infiltrado</strong>.
          </p>
          <div class="controls-preview">
            <div class="ctrl-item">
              <span class="ctrl-key">WASD</span>
              <span class="ctrl-label">Mover</span>
            </div>
            <div class="ctrl-item ctrl-mobile">
              <span class="ctrl-key">🕹️</span>
              <span class="ctrl-label">Joystick</span>
            </div>
            <div class="ctrl-item">
              <span class="ctrl-key">🖱️</span>
              <span class="ctrl-label">Apuntar</span>
            </div>
            <div class="ctrl-item">
              <span class="ctrl-key">CLICK</span>
              <span class="ctrl-label">Disparar</span>
            </div>
          </div>
          <button id="btn-start" type="button" class="game-btn">
            <span>Empezar defensa</span>
            <span class="text-xl">⚔️</span>
          </button>
        </section>

        {/* ============ PANTALLA 2: Juego ============ */}
        <section id="screen-game" class="screen">
          <div class="hud-top">
            <div class="hud-item">
              <span class="hud-label">Mariela</span>
              <div class="hud-hearts" id="hud-hearts">❤️❤️❤️</div>
            </div>
            <div class="hud-item">
              <span class="hud-label">Oleada</span>
              <div class="hud-wave" id="hud-wave">1 / 3</div>
            </div>
            <div class="hud-item">
              <span class="hud-label">Puntaje</span>
              <div class="hud-score" id="hud-score">0</div>
            </div>
          </div>

          <div class="canvas-wrap">
            <canvas id="game-canvas" width="720" height="320"></canvas>
            <div class="canvas-instructions">
              <span class="desktop-only">⌨️ WASD para mover · 🖱️ Click para disparar</span>
              <span class="mobile-only">🕹️ Joystick para mover · 👆 Tap para disparar</span>
            </div>
          </div>

          <div class="tower-hud">
            <div class="tower-hud-label">
              🏰 Torre del Infiltrado
            </div>
            <div class="tower-hp-track">
              <div id="tower-hp-fill" class="tower-hp-fill"></div>
            </div>
          </div>
        </section>

        {/* ============ PANTALLA 3: Victoria ============ */}
        <section id="screen-victory" class="screen">
          <div class="result-crown">🏆</div>
          <p class="game-stamp">Victoria</p>
          <h2 class="game-title">¡Torre destruida, Mariela!</h2>

          <div class="victory-stats">
            <div class="stat-row">
              <span class="stat-label">Puntaje final</span>
              <span id="stat-score" class="stat-value">0</span>
            </div>
            <div class="stat-row">
              <span class="stat-label">Minions derrotados</span>
              <span id="stat-kills" class="stat-value">0</span>
            </div>
            <div class="stat-row">
              <span class="stat-label">Disparos totales</span>
              <span id="stat-shots" class="stat-value">0</span>
            </div>
            <div class="stat-row">
              <span class="stat-label">Vidas restantes</span>
              <span id="stat-hp" class="stat-value">3 / 3</span>
            </div>
          </div>

          <p class="victory-message">
            Derrotaste a la Torre del Infiltrado. Como en todo lo que hacés,
            Mariela: con decisión, con fuerza y sin rendirte. Llegaste al final.
          </p>

          <div class="result-footer">
            <span class="line"></span>
            <span class="font-script text-2xl text-amber-300">Con amor, Andy</span>
            <span class="line"></span>
          </div>

          <p class="result-note">💛 Guardé tu victoria en un lugar especial.</p>
        </section>

        {/* ============ PANTALLA 4: Derrota ============ */}
        <section id="screen-defeat" class="screen">
          <div class="result-crown defeat-crown">💔</div>
          <p class="game-stamp">Casi...</p>
          <h2 class="game-title">Los minions te vencieron</h2>

          <p class="victory-message">
            Pero caíste peleando, Mariela. Y eso vale más que una victoria fácil.
            ¿Querés intentarlo de nuevo?
          </p>

          <button id="btn-retry" type="button" class="game-btn">
            <span>Reintentar</span>
            <span class="text-xl">🔄</span>
          </button>
        </section>

      </div>
    </main>

    <style is:global>
      .defense-body {
        margin: 0;
        min-height: 100vh;
        font-family: 'Inter', system-ui, sans-serif;
        color: #FFFCF2;
        background:
          radial-gradient(ellipse at 50% 0%, rgba(245, 176, 40, 0.15) 0%, transparent 55%),
          linear-gradient(180deg, #1A0F2E 0%, #2D1B4E 60%, #15081F 100%);
        background-attachment: fixed;
        overflow-x: hidden;
      }

      .magic-dust { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
      .dust {
        position: absolute;
        width: 2px; height: 2px;
        background: #FFD466;
        border-radius: 50%;
        opacity: 0.5;
        animation: twinkle 3s ease-in-out infinite;
      }
      @keyframes twinkle {
        0%, 100% { opacity: 0.2; }
        50% { opacity: 0.8; }
      }

      .defense-frame {
        width: 100%;
        max-width: 820px;
        background: linear-gradient(135deg, rgba(45, 27, 78, 0.85) 0%, rgba(26, 15, 46, 0.85) 100%);
        border: 1px solid rgba(255, 212, 102, 0.35);
        border-radius: 28px;
        padding: clamp(20px, 4vw, 40px);
        box-shadow: 0 30px 80px -20px rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        text-align: center;
        position: relative;
      }

      .screen { display: none; animation: screenIn 0.5s ease-out; }
      .screen-active { display: block; }
      @keyframes screenIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
      }

      .font-script { font-family: 'Cormorant Garamond', Georgia, serif; }

      .welcome-badge, .game-stamp {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 14px;
        border: 1px dashed rgba(255, 212, 102, 0.4);
        border-radius: 999px;
        color: #FFD466;
        font-size: 11px;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        margin-bottom: 18px;
      }

      .defense-title, .game-title {
        font-family: 'Cinzel', serif;
        font-size: clamp(28px, 5vw, 40px);
        font-weight: 700;
        background: linear-gradient(120deg, #FFD466 0%, #F5B028 50%, #FFD466 100%);
        background-size: 200% auto;
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        margin: 0 0 16px;
        line-height: 1.15;
      }

      .defense-subtitle, .victory-message {
        font-family: 'Cormorant Garamond', serif;
        font-style: italic;
        font-size: clamp(15px, 2.4vw, 18px);
        color: rgba(255, 252, 242, 0.85);
        line-height: 1.5;
        margin: 0 0 24px;
      }

      .controls-preview {
        display: flex;
        gap: 10px;
        justify-content: center;
        flex-wrap: wrap;
        margin-bottom: 24px;
      }
      .ctrl-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 14px;
        background: rgba(255, 252, 242, 0.04);
        border: 1px solid rgba(255, 212, 102, 0.2);
        border-radius: 999px;
        font-size: 12px;
      }
      .ctrl-key {
        font-family: 'Cinzel', serif;
        font-weight: 700;
        color: #FFD466;
        letter-spacing: 0.05em;
      }
      .ctrl-label { color: rgba(255, 252, 242, 0.75); font-size: 11px; }

      .game-btn {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 16px 36px;
        border-radius: 999px;
        border: none;
        background: linear-gradient(135deg, #FFD466 0%, #F5B028 100%);
        color: #2D1B4E;
        font-family: 'Cinzel', serif;
        font-weight: 600;
        font-size: 15px;
        cursor: pointer;
        box-shadow: 0 10px 30px -8px rgba(245, 176, 40, 0.55);
        transition: transform 0.25s, box-shadow 0.25s;
      }
      .game-btn:hover { transform: translateY(-2px); }

      /* HUD */
      .hud-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 14px;
        padding: 0 4px;
        gap: 8px;
      }
      .hud-item {
        text-align: center;
      }
      .hud-label {
        font-size: 10px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: rgba(255, 212, 102, 0.7);
        display: block;
        margin-bottom: 4px;
      }
      .hud-hearts {
        font-size: 16px;
        letter-spacing: 2px;
      }
      .hud-wave, .hud-score {
        font-family: 'Cinzel', serif;
        font-weight: 700;
        font-size: 16px;
        color: #FFD466;
      }

      /* Canvas */
      .canvas-wrap {
        position: relative;
        width: 100%;
        margin-bottom: 12px;
      }
      #game-canvas {
        width: 100%;
        height: auto;
        max-width: 720px;
        aspect-ratio: 720 / 320;
        background: linear-gradient(180deg, #1e1547 0%, #2d1b4e 50%, #4a2e1a 100%);
        border: 1.5px solid rgba(255, 212, 102, 0.35);
        border-radius: 14px;
        display: block;
        margin: 0 auto;
        cursor: crosshair;
        box-shadow: 0 0 30px rgba(255, 212, 102, 0.15) inset;
      }
      .canvas-instructions {
        position: absolute;
        top: 12px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(0, 0, 0, 0.5);
        padding: 4px 12px;
        border-radius: 999px;
        font-size: 11px;
        color: #FFD466;
        letter-spacing: 0.05em;
        pointer-events: none;
        white-space: nowrap;
      }
      .canvas-instructions .desktop-only { display: inline; }
      .canvas-instructions .mobile-only { display: none; }
      @media (hover: none) and (pointer: coarse) {
        .canvas-instructions .desktop-only { display: none; }
        .canvas-instructions .mobile-only { display: inline; }
      }

      /* Tower HUD */
      .tower-hud {
        margin-top: 6px;
        padding: 10px 14px;
        background: rgba(255, 252, 242, 0.04);
        border: 1px solid rgba(255, 212, 102, 0.2);
        border-radius: 12px;
      }
      .tower-hud-label {
        font-size: 11px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: rgba(255, 212, 102, 0.8);
        margin-bottom: 6px;
      }
      .tower-hp-track {
        height: 12px;
        background: rgba(0, 0, 0, 0.5);
        border: 1px solid rgba(255, 212, 102, 0.2);
        border-radius: 999px;
        overflow: hidden;
      }
      .tower-hp-fill {
        height: 100%;
        width: 100%;
        background: linear-gradient(90deg, #DC2626 0%, #EF4444 50%, #DC2626 100%);
        border-radius: 999px;
        transition: width 0.3s ease;
      }

      /* Resultado */
      .result-crown {
        font-size: 56px;
        margin-bottom: 8px;
        animation: crownFloat 3s ease-in-out infinite;
        filter: drop-shadow(0 4px 16px rgba(255, 212, 102, 0.5));
      }
      .defeat-crown { filter: drop-shadow(0 4px 16px rgba(220, 38, 38, 0.4)); }
      @keyframes crownFloat {
        0%, 100% { transform: translateY(0) rotate(-3deg); }
        50% { transform: translateY(-8px) rotate(3deg); }
      }

      .victory-stats {
        background: rgba(255, 252, 242, 0.04);
        border: 1px solid rgba(255, 212, 102, 0.2);
        border-radius: 14px;
        padding: 14px 18px;
        margin: 18px 0;
      }
      .stat-row {
        display: flex;
        justify-content: space-between;
        padding: 6px 0;
        font-size: 13px;
        color: rgba(255, 252, 242, 0.85);
        border-bottom: 1px solid rgba(255, 212, 102, 0.1);
      }
      .stat-row:last-child { border-bottom: none; }
      .stat-label {
        color: rgba(255, 212, 102, 0.8);
        font-size: 11px;
        letter-spacing: 0.15em;
        text-transform: uppercase;
      }
      .stat-value {
        font-family: 'Cinzel', serif;
        font-weight: 700;
        color: #FFD466;
      }

      .result-footer {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        margin: 14px 0;
      }
      .result-footer .line {
        flex: 1;
        max-width: 60px;
        height: 1px;
        background: linear-gradient(90deg, transparent, #FFD466, transparent);
      }
      .result-note {
        font-size: 12px;
        color: rgba(255, 252, 242, 0.6);
        font-style: italic;
        margin: 0;
      }
    </style>

    <script>
      const baseUrl = document.documentElement.dataset.baseUrl || '/mariela/';
      const workerUrl = 'https://mariela-responses.andyguzman117.workers.dev';

      const screens = {
        welcome: document.getElementById('screen-welcome')!,
        game: document.getElementById('screen-game')!,
        victory: document.getElementById('screen-victory')!,
        defeat: document.getElementById('screen-defeat')!
      };
      const showScreen = (name: keyof typeof screens) => {
        Object.values(screens).forEach((s) => s.classList.remove('screen-active'));
        screens[name].classList.add('screen-active');
      };

      const canvas = document.getElementById('game-canvas') as HTMLCanvasElement;
      const ctx = canvas.getContext('2d')!;
      const W = canvas.width;
      const H = canvas.height;
      const GROUND_Y = 270;
      const MARIELA_W = 50;
      const MARIELA_H = 64;
      const TOWER_W = 60;
      const TOWER_H = 180;

      type MinionType = 'small' | 'medium' | 'big' | 'speeder';

      type Minion = {
        x: number;
        y: number;
        hp: number;
        maxHp: number;
        speed: number;
        type: MinionType;
        flash: number;
      };

      type Projectile = {
        x: number;
        y: number;
        vx: number;
        vy: number;
        waveOffset: number;
        isLazaan: boolean;
      };

      type Particle = {
        x: number;
        y: number;
        vx: number;
        vy: number;
        life: number;
        maxLife: number;
        color: string;
        size: number;
      };

      type GameState = {
        marielaX: number;
        marielaY: number;
        marielaHP: number;
        marielaVX: number;
        marielaVY: number;
        marielaAngle: number;
        towerHP: number;
        towerMax: number;
        wave: number;
        waveProgress: number;
        minions: Minion[];
        projectiles: Projectile[];
        particles: Particle[];
        score: number;
        kills: number;
        shots: number;
        spawnTimer: number;
        status: 'fighting' | 'victory' | 'defeat';
        lastTime: number;
        towerShake: number;
        mouseX: number;
        mouseY: number;
      };

      const keys: any = {};

      const state: GameState = {
        marielaX: 60,
        marielaY: GROUND_Y - MARIELA_H,
        marielaHP: 3,
        marielaVX: 0,
        marielaVY: 0,
        marielaAngle: 0,
        towerHP: 100,
        towerMax: 100,
        wave: 1,
        waveProgress: 0,
        minions: [],
        projectiles: [],
        particles: [],
        score: 0,
        kills: 0,
        shots: 0,
        spawnTimer: 1.5,
        status: 'fighting',
        lastTime: performance.now(),
        towerShake: 0,
        mouseX: W / 2,
        mouseY: GROUND_Y - MARIELA_H
      };

      const resetState = () => {
        state.marielaX = 60;
        state.marielaY = GROUND_Y - MARIELA_H;
        state.marielaVX = 0;
        state.marielaVY = 0;
        state.marielaAngle = 0;
        state.marielaHP = 3;
        state.towerHP = 100;
        state.wave = 1;
        state.waveProgress = 0;
        state.minions = [];
        state.projectiles = [];
        state.particles = [];
        state.score = 0;
        state.kills = 0;
        state.shots = 0;
        state.spawnTimer = 1.5;
        state.status = 'fighting';
        state.towerShake = 0;
        updateHUD();
      };

      // ============================================================
      // DRAWING FUNCTIONS
      // ============================================================

      const drawBackground = () => {
        // Stars
        ctx.fillStyle = '#FFD466';
        for (let i = 0; i < 30; i++) {
          const x = (i * 47 + 13) % W;
          const y = (i * 23 + 7) % (GROUND_Y - 20);
          const s = (i % 3) + 1;
          ctx.globalAlpha = 0.4 + ((i * 7) % 10) / 20;
          ctx.fillRect(x, y, s, s);
        }
        ctx.globalAlpha = 1;

        // Ground
        const groundGrad = ctx.createLinearGradient(0, GROUND_Y, 0, H);
        groundGrad.addColorStop(0, '#5C3A1E');
        groundGrad.addColorStop(1, '#2D1B0E');
        ctx.fillStyle = groundGrad;
        ctx.fillRect(0, GROUND_Y, W, H - GROUND_Y);

        // Grass tufts (decorative)
        ctx.fillStyle = '#7CB342';
        for (let i = 0; i < 25; i++) {
          const x = i * 32 + 8;
          ctx.fillRect(x, GROUND_Y - 3, 2, 3);
          ctx.fillRect(x + 4, GROUND_Y - 4, 2, 4);
        }
      };

      const drawMariela = () => {
        const x = state.marielaX;
        const y = state.marielaY;
        const isMoving = Math.abs(state.marielaVX) > 5 || Math.abs(state.marielaVY) > 5;
        const walkFrame = isMoving ? Math.floor(performance.now() / 150) % 2 : 0;

        // Glow
        const cx = x + MARIELA_W / 2;
        const cy = y + MARIELA_H / 2;
        const glowGrad = ctx.createRadialGradient(cx, cy, 0, cx, cy, 55);
        glowGrad.addColorStop(0, 'rgba(255, 212, 102, 0.4)');
        glowGrad.addColorStop(1, 'rgba(255, 212, 102, 0)');
        ctx.fillStyle = glowGrad;
        ctx.fillRect(x - 20, y - 20, MARIELA_W + 40, MARIELA_H + 40);

        // Rotar a Mariela según ángulo de mira
        ctx.save();
        ctx.translate(cx, cy);
        ctx.rotate(state.marielaAngle);

        // Body (dress/robe)
        ctx.fillStyle = '#F5B028';
        ctx.beginPath();
        ctx.moveTo(-MARIELA_W / 2 + 8, -MARIELA_H / 2 + 20);
        ctx.lineTo(MARIELA_W / 2 - 8, -MARIELA_H / 2 + 20);
        ctx.lineTo(MARIELA_W / 2 - 4, MARIELA_H / 2);
        ctx.lineTo(-MARIELA_W / 2 + 4, MARIELA_H / 2);
        ctx.closePath();
        ctx.fill();
        ctx.strokeStyle = '#A56B0E';
        ctx.lineWidth = 1.5;
        ctx.stroke();

        // Head
        ctx.fillStyle = '#FEF3C7';
        ctx.beginPath();
        ctx.arc(0, -MARIELA_H / 2 + 16, 12, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = '#D97706';
        ctx.lineWidth = 1.2;
        ctx.stroke();

        // Hair
        ctx.fillStyle = '#92400E';
        ctx.beginPath();
        ctx.arc(-4, -MARIELA_H / 2 + 8, 9, Math.PI, Math.PI * 2);
        ctx.fill();
        ctx.fillRect(-13, -MARIELA_H / 2 + 8, 5, 12);

        // Crown
        ctx.fillStyle = '#FFD466';
        ctx.beginPath();
        ctx.moveTo(-8, -MARIELA_H / 2 + 4);
        ctx.lineTo(-5, -MARIELA_H / 2 - 1);
        ctx.lineTo(-2, -MARIELA_H / 2 + 4);
        ctx.lineTo(1, -MARIELA_H / 2 - 1);
        ctx.lineTo(4, -MARIELA_H / 2 + 4);
        ctx.lineTo(7, -MARIELA_H / 2 - 1);
        ctx.lineTo(8, -MARIELA_H / 2 + 4);
        ctx.closePath();
        ctx.fill();
        ctx.strokeStyle = '#D97706';
        ctx.lineWidth = 0.8;
        ctx.stroke();

        // Arco (apunta hacia adelante según rotación)
        ctx.strokeStyle = '#92400E';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.arc(MARIELA_W / 2 + 4, 4, 12, -Math.PI / 3, Math.PI / 3);
        ctx.stroke();
        ctx.strokeStyle = '#FFFCF2';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(MARIELA_W / 2 + 4, -8);
        ctx.lineTo(MARIELA_W / 2 + 4, 16);
        ctx.stroke();

        // Piernas (animadas)
        ctx.fillStyle = '#A56B0E';
        if (walkFrame === 0) {
          ctx.fillRect(-8, MARIELA_H / 2 - 2, 6, 4);
          ctx.fillRect(4, MARIELA_H / 2 - 1, 6, 3);
        } else {
          ctx.fillRect(-8, MARIELA_H / 2 - 1, 6, 3);
          ctx.fillRect(4, MARIELA_H / 2 - 2, 6, 4);
        }

        ctx.restore();
      };

      // Indicador de mira
      const drawAimIndicator = () => {
        const cx = state.marielaX + MARIELA_W / 2;
        const cy = state.marielaY + MARIELA_H / 2;
        const dx = state.mouseX - cx;
        const dy = state.mouseY - cy;
        const dist = Math.hypot(dx, dy) || 1;

        // Línea de mira
        ctx.strokeStyle = 'rgba(255, 212, 102, 0.35)';
        ctx.lineWidth = 1.5;
        ctx.setLineDash([4, 4]);
        ctx.beginPath();
        ctx.moveTo(cx + (dx / dist) * 35, cy + (dy / dist) * 35);
        ctx.lineTo(state.mouseX, state.mouseY);
        ctx.stroke();
        ctx.setLineDash([]);

        // Cursor/mira
        ctx.strokeStyle = '#FFD466';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.arc(state.mouseX, state.mouseY, 12, 0, Math.PI * 2);
        ctx.stroke();
        ctx.beginPath();
        ctx.moveTo(state.mouseX - 16, state.mouseY);
        ctx.lineTo(state.mouseX - 6, state.mouseY);
        ctx.moveTo(state.mouseX + 6, state.mouseY);
        ctx.lineTo(state.mouseX + 16, state.mouseY);
        ctx.moveTo(state.mouseX, state.mouseY - 16);
        ctx.lineTo(state.mouseX, state.mouseY - 6);
        ctx.moveTo(state.mouseX, state.mouseY + 6);
        ctx.lineTo(state.mouseX, state.mouseY + 16);
        ctx.stroke();
      };

      const drawMinion = (m: Minion) => {
        const x = m.x;
        const y = m.y;
        const sizes = {
          small: { w: 24, h: 34 },
          speeder: { w: 20, h: 28 },
          medium: { w: 30, h: 42 },
          big: { w: 38, h: 54 }
        };
        const colors: Record<MinionType, { fill: string; stroke: string; eye: string }> = {
          small:   { fill: '#DC2626', stroke: '#7F1D1D', eye: '#FBBF24' },
          speeder: { fill: '#FBBF24', stroke: '#B45309', eye: '#7F1D1D' },
          medium:  { fill: '#7C3AED', stroke: '#4C1D95', eye: '#FCA5A5' },
          big:     { fill: '#1F2937', stroke: '#0F172A', eye: '#EF4444' }
        };
        const sz = sizes[m.type];
        const w = sz.w;
        const h = sz.h;
        const palette = colors[m.type];

        // Flash on hit
        const fill = m.flash > 0 ? '#FFFFFF' : palette.fill;
        const stroke = m.flash > 0 ? '#FFFFFF' : palette.stroke;

        // Body
        ctx.fillStyle = fill;
        ctx.beginPath();
        ctx.arc(x + w / 2, y + h / 2 - 4, w / 2, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = stroke;
        ctx.lineWidth = 1.5;
        ctx.stroke();

        // Detalle: helmet/spikes para big
        if (m.type === 'big') {
          ctx.fillStyle = '#450A0A';
          for (let i = 0; i < 3; i++) {
            const sx = x + w / 2 - 10 + i * 10;
            ctx.beginPath();
            ctx.moveTo(sx, y + 2);
            ctx.lineTo(sx + 3, y - 4);
            ctx.lineTo(sx + 6, y + 2);
            ctx.closePath();
            ctx.fill();
          }
        }

        // Speed lines para speeder
        if (m.type === 'speeder') {
          ctx.strokeStyle = '#FCD34D';
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(x + w, y + h / 2 - 6);
          ctx.lineTo(x + w + 12, y + h / 2 - 6);
          ctx.moveTo(x + w, y + h / 2);
          ctx.lineTo(x + w + 14, y + h / 2);
          ctx.moveTo(x + w, y + h / 2 + 6);
          ctx.lineTo(x + w + 12, y + h / 2 + 6);
          ctx.stroke();
        }

        // Eyes
        ctx.fillStyle = palette.eye;
        const eyeOff = m.type === 'big' ? 7 : 5;
        ctx.beginPath();
        ctx.arc(x + w / 2 - eyeOff, y + 10, m.type === 'big' ? 4 : 3, 0, Math.PI * 2);
        ctx.arc(x + w / 2 + eyeOff, y + 10, m.type === 'big' ? 4 : 3, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#000';
        ctx.beginPath();
        ctx.arc(x + w / 2 - eyeOff, y + 10, m.type === 'big' ? 1.8 : 1.2, 0, Math.PI * 2);
        ctx.arc(x + w / 2 + eyeOff, y + 10, m.type === 'big' ? 1.8 : 1.2, 0, Math.PI * 2);
        ctx.fill();

        // Mouth
        ctx.strokeStyle = '#000';
        ctx.lineWidth = 1.2;
        ctx.beginPath();
        ctx.arc(x + w / 2, y + 18, m.type === 'big' ? 7 : 5, 0.2, Math.PI - 0.2);
        ctx.stroke();

        // HP bar (only if damaged)
        if (m.hp < m.maxHp) {
          ctx.fillStyle = '#000';
          ctx.fillRect(x, y - 8, w, 4);
          const hpColor = m.hp / m.maxHp > 0.5 ? '#4ADE80' : m.hp / m.maxHp > 0.25 ? '#FBBF24' : '#EF4444';
          ctx.fillStyle = hpColor;
          ctx.fillRect(x, y - 8, (w * m.hp) / m.maxHp, 4);
        }
      };

      const drawTower = () => {
        const towerX = W - TOWER_W - 30 + state.towerShake;
        const towerY = GROUND_Y - TOWER_H;

        // Tower body
        const towerGrad = ctx.createLinearGradient(towerX, 0, towerX + TOWER_W, 0);
        towerGrad.addColorStop(0, '#1F2937');
        towerGrad.addColorStop(0.5, '#374151');
        towerGrad.addColorStop(1, '#1F2937');
        ctx.fillStyle = towerGrad;
        ctx.fillRect(towerX, towerY, TOWER_W, TOWER_H);

        // Stone outline
        ctx.strokeStyle = '#0F172A';
        ctx.lineWidth = 2;
        ctx.strokeRect(towerX, towerY, TOWER_W, TOWER_H);

        // Windows
        const windowCount = 4;
        for (let i = 0; i < windowCount; i++) {
          const wx = towerX + 12;
          const wy = towerY + 20 + i * 40;
          const glowAlpha = state.towerHP < 30 ? 0.4 : 0.8;
          ctx.fillStyle = `rgba(251, 191, 36, ${glowAlpha})`;
          ctx.fillRect(wx, wy, TOWER_W - 24, 18);
          ctx.strokeStyle = '#92400E';
          ctx.lineWidth = 1.5;
          ctx.strokeRect(wx, wy, TOWER_W - 24, 18);
          // Cross
          ctx.beginPath();
          ctx.moveTo(wx + (TOWER_W - 24) / 2, wy);
          ctx.lineTo(wx + (TOWER_W - 24) / 2, wy + 18);
          ctx.moveTo(wx, wy + 9);
          ctx.lineTo(wx + (TOWER_W - 24), wy + 9);
          ctx.stroke();
        }

        // Battlements (top)
        ctx.fillStyle = '#374151';
        for (let i = 0; i < 5; i++) {
          const bx = towerX - 4 + i * 14;
          ctx.fillRect(bx, towerY - 12, 10, 14);
          ctx.strokeStyle = '#0F172A';
          ctx.strokeRect(bx, towerY - 12, 10, 14);
        }

        // Flag
        ctx.strokeStyle = '#92400E';
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(towerX + TOWER_W / 2, towerY - 12);
        ctx.lineTo(towerX + TOWER_W / 2, towerY - 60);
        ctx.stroke();

        ctx.fillStyle = '#DC2626';
        ctx.beginPath();
        ctx.moveTo(towerX + TOWER_W / 2, towerY - 60);
        ctx.lineTo(towerX + TOWER_W / 2 + 24, towerY - 54);
        ctx.lineTo(towerX + TOWER_W / 2, towerY - 48);
        ctx.closePath();
        ctx.fill();

        // Eye/face on tower (gets angrier as HP drops)
        const faceY = towerY + TOWER_H / 2;
        ctx.fillStyle = '#FBBF24';
        ctx.beginPath();
        ctx.arc(towerX + TOWER_W / 2 - 6, faceY, 3, 0, Math.PI * 2);
        ctx.arc(towerX + TOWER_W / 2 + 6, faceY, 3, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = '#000';
        ctx.beginPath();
        ctx.arc(towerX + TOWER_W / 2 - 6, faceY, 1.5, 0, Math.PI * 2);
        ctx.arc(towerX + TOWER_W / 2 + 6, faceY, 1.5, 0, Math.PI * 2);
        ctx.fill();
      };

      const drawProjectile = (p: Projectile) => {
        // Glow púrpura (estilo Lazaan)
        ctx.fillStyle = 'rgba(168, 85, 247, 0.3)';
        ctx.beginPath();
        ctx.arc(p.x, p.y, 11, 0, Math.PI * 2);
        ctx.fill();

        // Arrow head púrpura
        ctx.fillStyle = '#A855F7';
        ctx.beginPath();
        ctx.arc(p.x, p.y, 5, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = '#F0ABFC';
        ctx.lineWidth = 1;
        ctx.stroke();

        // Núcleo brillante
        ctx.fillStyle = '#FAE8FF';
        ctx.beginPath();
        ctx.arc(p.x, p.y, 2, 0, Math.PI * 2);
        ctx.fill();

        // Trail ondulado púrpura
        const speed = Math.hypot(p.vx, p.vy) || 1;
        const trailLen = 24;
        const trailX = p.x - (p.vx / speed) * trailLen;
        const trailY = p.y - (p.vy / speed) * trailLen;
        const trailGrad = ctx.createLinearGradient(trailX, trailY, p.x, p.y);
        trailGrad.addColorStop(0, 'rgba(168, 85, 247, 0)');
        trailGrad.addColorStop(0.5, 'rgba(192, 132, 252, 0.4)');
        trailGrad.addColorStop(1, 'rgba(232, 121, 249, 0.9)');
        ctx.strokeStyle = trailGrad;
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(trailX, trailY);
        ctx.lineTo(p.x, p.y);
        ctx.stroke();

        // Sparkles alrededor
        const sparkleAngle = (p.x + p.y) * 0.1;
        for (let i = 0; i < 3; i++) {
          const a = sparkleAngle + (i * Math.PI * 2 / 3);
          const sx = p.x + Math.cos(a) * 8;
          const sy = p.y + Math.sin(a) * 8;
          ctx.fillStyle = '#F0ABFC';
          ctx.beginPath();
          ctx.arc(sx, sy, 1.2, 0, Math.PI * 2);
          ctx.fill();
        }
      };

      const drawParticles = () => {
        state.particles.forEach((p) => {
          ctx.globalAlpha = p.life / p.maxLife;
          ctx.fillStyle = p.color;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
          ctx.fill();
        });
        ctx.globalAlpha = 1;
      };

      // ============================================================
      // GAME LOGIC
      // ============================================================

      // Carriles: alto / medio / bajo (top-down MOBA style)
      const lanes = [
        GROUND_Y - MARIELA_H - 60, // alto
        GROUND_Y - MARIELA_H - 20, // medio
        GROUND_Y - MARIELA_H + 20  // bajo
      ];

      const spawnMinion = () => {
        const laneY = lanes[Math.floor(Math.random() * lanes.length)] + (Math.random() * 30 - 15);
        // Selección de tipo según wave y random
        const r = Math.random();
        let type: MinionType = 'small';
        if (state.wave === 1) {
          type = r < 0.6 ? 'small' : 'speeder';
        } else if (state.wave === 2) {
          if (r < 0.35) type = 'small';
          else if (r < 0.65) type = 'speeder';
          else if (r < 0.9) type = 'medium';
          else type = 'big';
        } else {
          if (r < 0.2) type = 'small';
          else if (r < 0.45) type = 'speeder';
          else if (r < 0.75) type = 'medium';
          else type = 'big';
        }

        const configs = {
          small:   { hp: 1, speed: 75  + state.wave * 6,  w: 24, h: 34 },
          speeder: { hp: 1, speed: 130 + state.wave * 8,  w: 20, h: 28 },
          medium:  { hp: 2, speed: 55  + state.wave * 5,  w: 30, h: 42 },
          big:     { hp: 4, speed: 38  + state.wave * 3,  w: 38, h: 54 }
        };
        const cfg = configs[type];

        state.minions.push({
          x: W + 30,
          y: laneY,
          hp: cfg.hp,
          maxHp: cfg.hp,
          speed: cfg.speed,
          type,
          flash: 0
        });
      };

      const shoot = () => {
        if (state.status !== 'fighting') return;
        state.shots++;
        const cx = state.marielaX + MARIELA_W / 2;
        const cy = state.marielaY + MARIELA_H / 2;
        const dx = state.mouseX - cx;
        const dy = state.mouseY - cy;
        const dist = Math.hypot(dx, dy) || 1;
        const speed = 480;
        const vx = (dx / dist) * speed;
        const vy = (dy / dist) * speed;

        // Lazaan: 3 flechas con diferentes ondas/fases
        for (let i = -1; i <= 1; i++) {
          state.projectiles.push({
            x: cx + (dx / dist) * 30,
            y: cy + (dy / dist) * 30,
            vx,
            vy: vy + i * 25,  // ligero spread vertical
            waveOffset: i * Math.PI / 2,  // desfase para patrón ondulado
            isLazaan: true
          });
        }
        state.marielaAngle = Math.atan2(dy, dx);
      };

      const spawnParticles = (x: number, y: number, color: string, count = 8) => {
        for (let i = 0; i < count; i++) {
          const angle = (Math.PI * 2 * i) / count + Math.random() * 0.5;
          state.particles.push({
            x,
            y,
            vx: Math.cos(angle) * (60 + Math.random() * 60),
            vy: Math.sin(angle) * (60 + Math.random() * 60) - 20,
            life: 0.6,
            maxLife: 0.6,
            color,
            size: 2 + Math.random() * 2
          });
        }
      };

      const updateTowerHUD = () => {
        const fill = document.getElementById('tower-hp-fill') as HTMLElement;
        if (fill) fill.style.width = `${(state.towerHP / state.towerMax) * 100}%`;
      };

      const updateHUD = () => {
        const hearts = document.getElementById('hud-hearts');
        const wave = document.getElementById('hud-wave');
        const score = document.getElementById('hud-score');
        if (hearts) hearts.textContent = '❤️'.repeat(Math.max(0, state.marielaHP)) || '💀';
        if (wave) wave.textContent = `${state.wave} / 3`;
        if (score) score.textContent = String(state.score);
        updateTowerHUD();
      };

      const rectCollision = (a: { x: number; y: number; w?: number; h?: number }, b: { x: number; y: number; w?: number; h?: number }, aw = 30, ah = 30, bw = 30, bh = 30) => {
        return (
          a.x < (b.x + bw) &&
          (a.x + aw) > b.x &&
          a.y < (b.y + bh) &&
          (a.y + ah) > b.y
        );
      };

      const update = (dt: number) => {
        if (state.status !== 'fighting') return;

        // Tower shake decay
        if (state.towerShake > 0) state.towerShake = Math.max(0, state.towerShake - dt * 30);

        // Wave progression
        state.spawnTimer -= dt;
        const waveConfig: Record<number, { spawns: number; total: number }> = {
          1: { spawns: 5, total: 5 },
          2: { spawns: 7, total: 7 },
          3: { spawns: 9, total: 9 }
        };
        const cfg = waveConfig[state.wave];
        if (state.waveProgress < cfg.spawns && state.spawnTimer <= 0) {
          spawnMinion();
          state.waveProgress++;
          state.spawnTimer = state.wave === 3 ? 0.8 : 1.2;
        }

        // Mariela movement (WASD/arrows)
        const speed = 200;
        state.marielaVX = 0;
        state.marielaVY = 0;
        if (keys['ArrowLeft'] || keys['a'] || keys['A']) state.marielaVX -= speed;
        if (keys['ArrowRight'] || keys['d'] || keys['D']) state.marielaVX += speed;
        if (keys['ArrowUp'] || keys['w'] || keys['W']) state.marielaVY -= speed;
        if (keys['ArrowDown'] || keys['s'] || keys['S']) state.marielaVY += speed;

        // Apply movement
        state.marielaX += state.marielaVX * dt;
        state.marielaY += state.marielaVY * dt;

        // Bounds
        if (state.marielaX < 10) state.marielaX = 10;
        if (state.marielaX > W - MARIELA_W - 10) state.marielaX = W - MARIELA_W - 10;
        if (state.marielaY < 20) state.marielaY = 20;
        if (state.marielaY > GROUND_Y - MARIELA_H) state.marielaY = GROUND_Y - MARIELA_H;

        // Move minions
        state.minions.forEach((m) => {
          m.x -= m.speed * dt;
          if (m.flash > 0) m.flash -= dt * 4;
        });

        // Move projectiles (direction-based) with Lazaan wave motion
        state.projectiles.forEach((p) => {
          p.x += p.vx * dt;
          p.y += p.vy * dt;
          // Movimiento ondulado tipo Lazaan (Hanabi)
          if (p.isLazaan) {
            p.waveOffset += dt * 12;
            p.y += Math.sin(p.waveOffset) * 60 * dt;
          }
        });

        // Move particles
        state.particles.forEach((p) => {
          p.x += p.vx * dt;
          p.y += p.vy * dt;
          p.vy += 200 * dt;
          p.life -= dt;
        });

        // Collision: projectile vs minion
        state.projectiles = state.projectiles.filter((p) => {
          let hit = false;
          state.minions = state.minions.filter((m) => {
            const mh = m.type === 'big' ? 50 : 36;
            const mw = m.type === 'big' ? 36 : 26;
            const my = m.y;
            if (rectCollision({ x: p.x - 5, y: p.y - 5, w: 10, h: 10 }, { x: m.x, y: my, w: mw, h: mh }, 10, 10, mw, mh)) {
              m.hp--;
              m.flash = 0.2;
              hit = true;
              spawnParticles(m.x + mw / 2, my + mh / 2, '#FFD466', 6);
              if (m.hp <= 0) {
                state.score += m.type === 'big' ? 30 : 15;
                state.kills++;
                spawnParticles(m.x + mw / 2, my + mh / 2, '#DC2626', 12);
                return false;
              }
            }
            return true;
          });
          return p.x > -20 && p.x < W + 20 && p.y > -20 && p.y < H + 20 && !hit;
        });

        // Collision: minion vs Mariela
        state.minions = state.minions.filter((m) => {
          const mh = m.type === 'big' ? 50 : 36;
          const mw = m.type === 'big' ? 36 : 26;
          const my = m.y;
          const mx = m.x;
          if (
            mx < state.marielaX + MARIELA_W &&
            mx + mw > state.marielaX &&
            my < state.marielaY + MARIELA_H &&
            my + mh > state.marielaY
          ) {
            state.marielaHP--;
            spawnParticles(state.marielaX + MARIELA_W / 2, state.marielaY + MARIELA_H / 2, '#DC2626', 14);
            return false;
          }
          return true;
        });

        // Mariela auto-attacks tower when close (Lazaan a la torre)
        const towerX = W - TOWER_W - 30;
        const distToTower = Math.hypot(
          state.marielaX + MARIELA_W / 2 - (towerX + TOWER_W / 2),
          state.marielaY + MARIELA_H / 2 - (GROUND_Y - TOWER_H / 2)
        );
        if (
          distToTower < 120 &&
          state.wave >= 3 &&
          state.waveProgress >= cfg.total &&
          state.minions.length === 0 &&
          state.towerHP > 0
        ) {
          if (Math.random() < dt * 3.5) {
            state.towerHP = Math.max(0, state.towerHP - 5);  // Mucho más daño
            state.towerShake = 6;
            spawnParticles(towerX + TOWER_W / 2, GROUND_Y - TOWER_H / 2, '#A855F7', 8);
            spawnParticles(towerX + TOWER_W / 2, GROUND_Y - TOWER_H / 2, '#EF4444', 6);
            // Flecha visual hacia la torre
            const arrowX = state.marielaX + MARIELA_W;
            const arrowY = state.marielaY + MARIELA_H / 2;
            for (let i = 0; i < 5; i++) {
              spawnParticles(
                arrowX + (towerX - arrowX) * (i / 5),
                arrowY + (Math.random() - 0.5) * 30,
                '#A855F7',
                1
              );
            }
            updateTowerHUD();
          }
        }

        // Clean up
        state.minions = state.minions.filter((m) => m.x > -50);
        state.particles = state.particles.filter((p) => p.life > 0);

        // Wave transition
        if (state.waveProgress >= cfg.total && state.minions.length === 0 && state.towerHP > 0) {
          if (state.wave < 3) {
            state.wave++;
            state.waveProgress = 0;
            state.spawnTimer = 1.5;
          }
        }

        // Check victory
        if (state.towerHP <= 0) {
          state.status = 'victory';
          setTimeout(showVictoryScreen, 600);
        }

        // Check defeat
        if (state.marielaHP <= 0) {
          state.status = 'defeat';
          setTimeout(showDefeatScreen, 600);
        }

        updateHUD();
      };

      const render = () => {
        ctx.clearRect(0, 0, W, H);
        drawBackground();
        drawTower();
        state.minions.forEach(drawMinion);
        state.projectiles.forEach(drawProjectile);
        drawParticles();
        drawMariela();
        drawAimIndicator();
        drawJoystick();
      };

      const gameLoop = (now: number) => {
        const dt = Math.min(0.05, (now - state.lastTime) / 1000);
        state.lastTime = now;

        if (state.status === 'fighting') {
          update(dt);
          render();
        }
        requestAnimationFrame(gameLoop);
      };

      // ============================================================
      // INPUT
      // ============================================================
      const handleShoot = () => {
        if (state.status !== 'fighting') return;
        shoot();
      };

      canvas.addEventListener('click', handleShoot);

      // ============================================================
      // JOYSTICK VIRTUAL (para móvil)
      // ============================================================
      const joystick = {
        active: false,
        mouseActive: false,
        touchId: null as number | null,
        baseX: 75,
        baseY: 240,
        thumbX: 75,
        thumbY: 240,
        radius: 55,
        thumbRadius: 22
      };

      const updateJoystick = (x: number, y: number) => {
        const dx = x - joystick.baseX;
        const dy = y - joystick.baseY;
        const dist = Math.hypot(dx, dy);
        const maxDist = joystick.radius;

        if (dist > maxDist) {
          joystick.thumbX = joystick.baseX + (dx / dist) * maxDist;
          joystick.thumbY = joystick.baseY + (dy / dist) * maxDist;
        } else {
          joystick.thumbX = x;
          joystick.thumbY = y;
        }

        const moveX = (joystick.thumbX - joystick.baseX) / maxDist;
        const moveY = (joystick.thumbY - joystick.baseY) / maxDist;
        keys['ArrowLeft'] = moveX < -0.25;
        keys['ArrowRight'] = moveX > 0.25;
        keys['ArrowUp'] = moveY < -0.25;
        keys['ArrowDown'] = moveY > 0.25;
      };

      const resetJoystick = () => {
        joystick.active = false;
        joystick.mouseActive = false;
        joystick.touchId = null;
        joystick.thumbX = joystick.baseX;
        joystick.thumbY = joystick.baseY;
        keys['ArrowLeft'] = false;
        keys['ArrowRight'] = false;
        keys['ArrowUp'] = false;
        keys['ArrowDown'] = false;
      };

      const drawJoystick = () => {
        ctx.save();
        const alpha = joystick.active ? 0.85 : 0.35;
        ctx.globalAlpha = alpha;

        // Base
        const baseGrad = ctx.createRadialGradient(
          joystick.baseX, joystick.baseY, 0,
          joystick.baseX, joystick.baseY, joystick.radius
        );
        baseGrad.addColorStop(0, 'rgba(255, 212, 102, 0.25)');
        baseGrad.addColorStop(1, 'rgba(255, 212, 102, 0.1)');
        ctx.fillStyle = baseGrad;
        ctx.beginPath();
        ctx.arc(joystick.baseX, joystick.baseY, joystick.radius, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = 'rgba(255, 212, 102, 0.6)';
        ctx.lineWidth = 2;
        ctx.stroke();

        // Líneas guía (cruz)
        ctx.strokeStyle = 'rgba(255, 212, 102, 0.3)';
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(joystick.baseX - joystick.radius * 0.7, joystick.baseY);
        ctx.lineTo(joystick.baseX + joystick.radius * 0.7, joystick.baseY);
        ctx.moveTo(joystick.baseX, joystick.baseY - joystick.radius * 0.7);
        ctx.lineTo(joystick.baseX, joystick.baseY + joystick.radius * 0.7);
        ctx.stroke();

        // Línea de dirección (cuando está activo)
        if (joystick.active) {
          ctx.strokeStyle = 'rgba(255, 212, 102, 0.7)';
          ctx.lineWidth = 2;
          ctx.beginPath();
          ctx.moveTo(joystick.baseX, joystick.baseY);
          ctx.lineTo(joystick.thumbX, joystick.thumbY);
          ctx.stroke();
        }

        // Thumb
        const thumbGrad = ctx.createRadialGradient(
          joystick.thumbX - 6, joystick.thumbY - 6, 0,
          joystick.thumbX, joystick.thumbY, joystick.thumbRadius
        );
        thumbGrad.addColorStop(0, '#FEF3C7');
        thumbGrad.addColorStop(1, '#F5B028');
        ctx.fillStyle = thumbGrad;
        ctx.beginPath();
        ctx.arc(joystick.thumbX, joystick.thumbY, joystick.thumbRadius, 0, Math.PI * 2);
        ctx.fill();
        ctx.strokeStyle = '#D97706';
        ctx.lineWidth = 2;
        ctx.stroke();

        ctx.restore();
      };

      const isOnJoystick = (x: number, y: number) => {
        const dist = Math.hypot(x - joystick.baseX, y - joystick.baseY);
        return dist <= joystick.radius * 1.5; // zona un poco más grande que el radio base
      };

      // Mouse tracking para aim + joystick
      canvas.addEventListener('mousemove', (e) => {
        const rect = canvas.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * W;
        const y = ((e.clientY - rect.top) / rect.height) * H;
        if (joystick.mouseActive) {
          updateJoystick(x, y);
        } else {
          state.mouseX = x;
          state.mouseY = y;
        }
      });

      canvas.addEventListener('mousedown', (e) => {
        const rect = canvas.getBoundingClientRect();
        const x = ((e.clientX - rect.left) / rect.width) * W;
        const y = ((e.clientY - rect.top) / rect.height) * H;
        if (isOnJoystick(x, y)) {
          joystick.mouseActive = true;
          updateJoystick(x, y);
        } else {
          state.mouseX = x;
          state.mouseY = y;
          handleShoot();
        }
      });

      canvas.addEventListener('mouseup', () => {
        if (joystick.mouseActive) {
          resetJoystick();
        }
      });

      // Touch handlers
      canvas.addEventListener('touchstart', (e) => {
        e.preventDefault();
        for (let i = 0; i < e.changedTouches.length; i++) {
          const touch = e.changedTouches[i];
          const rect = canvas.getBoundingClientRect();
          const x = ((touch.clientX - rect.left) / rect.width) * W;
          const y = ((touch.clientY - rect.top) / rect.height) * H;

          if (isOnJoystick(x, y) && !joystick.active) {
            joystick.active = true;
            joystick.touchId = touch.identifier;
            updateJoystick(x, y);
          } else if (joystick.touchId !== touch.identifier) {
            state.mouseX = x;
            state.mouseY = y;
            handleShoot();
          }
        }
      }, { passive: false });

      canvas.addEventListener('touchmove', (e) => {
        e.preventDefault();
        for (let i = 0; i < e.changedTouches.length; i++) {
          const touch = e.changedTouches[i];
          const rect = canvas.getBoundingClientRect();
          const x = ((touch.clientX - rect.left) / rect.width) * W;
          const y = ((touch.clientY - rect.top) / rect.height) * H;
          if (touch.identifier === joystick.touchId && joystick.active) {
            updateJoystick(x, y);
          } else {
            state.mouseX = x;
            state.mouseY = y;
          }
        }
      }, { passive: false });

      canvas.addEventListener('touchend', (e) => {
        for (let i = 0; i < e.changedTouches.length; i++) {
          const touch = e.changedTouches[i];
          if (touch.identifier === joystick.touchId) {
            resetJoystick();
          }
        }
      });

      canvas.addEventListener('touchcancel', () => {
        resetJoystick();
      });

      // Teclado: WASD/flechas para mover, SPACE para disparar
      document.addEventListener('keydown', (e) => {
        const key = e.key;
        keys[key] = true;
        keys[e.code] = true;
        if (e.code === 'Space' || e.key === ' ') {
          e.preventDefault();
          handleShoot();
        }
      });
      document.addEventListener('keyup', (e) => {
        keys[e.key] = false;
        keys[e.code] = false;
      });

      // ============================================================
      // SCREENS
      // ============================================================
      document.getElementById('btn-start')?.addEventListener('click', () => {
        resetState();
        showScreen('game');
        state.lastTime = performance.now();
        requestAnimationFrame(gameLoop);
      });

      document.getElementById('btn-retry')?.addEventListener('click', () => {
        resetState();
        showScreen('game');
      });

      const showVictoryScreen = () => {
        const scoreEl = document.getElementById('stat-score');
        const killsEl = document.getElementById('stat-kills');
        const shotsEl = document.getElementById('stat-shots');
        const hpEl = document.getElementById('stat-hp');
        if (scoreEl) scoreEl.textContent = String(state.score);
        if (killsEl) killsEl.textContent = String(state.kills);
        if (shotsEl) shotsEl.textContent = String(state.shots);
        if (hpEl) hpEl.textContent = `${Math.max(0, state.marielaHP)} / 3`;
        showScreen('victory');
        sendToWorker(true);
      };

      const showDefeatScreen = () => {
        showScreen('defeat');
        sendToWorker(false);
      };

      const sendToWorker = async (won: boolean) => {
        try {
          const formData = new FormData();
          formData.set('Respuesta', won ? 'Victoria - Torre destruida' : 'Derrota en la defensa');
          formData.set(
            'Mensaje',
            `Puntaje: ${state.score} | Kills: ${state.kills} | Disparos: ${state.shots} | Vidas: ${state.marielaHP}/3`
          );
          await fetch(workerUrl, {
            method: 'POST',
            body: formData,
            headers: { Accept: 'application/json' }
          });
        } catch (err) {
          console.warn('No se pudo guardar:', err);
        }
      };

      // Init
      resetState();
      render();
    </script>
  </body>
</html>
