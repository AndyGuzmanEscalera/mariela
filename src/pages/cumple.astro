---
/**
 * /cumple — Semana de cumpleaños de Mariela
 * ----------------------------------------------------
 * Del Martes 29 Sept al Domingo 4 Oct (su cumpleaños).
 * Cada día se desbloquea una carta nueva a las 06:00 hs.
 *
 * ⚠️  PROTOTIPO: las cartas de Miércoles a Domingo tienen
 *     texto de placeholder. Edita el array `days` abajo
 *     para personalizarlas con tu mensaje.
 */

// Array con los 6 días. Edita libremente los textos.
const days = [
  {
    id: 'martes',
    number: 1,
    date: '2026-09-29',
    dayName: 'Martes',
    dateLabel: '29 de Septiembre',
    title: 'Mujer genial y fuerte',
    frontMessage: 'Hoy quiero recordarte algo: eres una mujer genial y muy fuerte. 💛',
    photo: 'photos/mariela-martes.jpg',
    requiresPassword: true,
    password: '26',
    passwordHint: '¿Cuántos años cumpliste el año que nos conocimos?',
    insideTitle: 'Tu esencia y tu valentía',
    insideMessage:
      '📖 Martes 29 de septiembre — Su fortaleza e integridad\n\n' +
      '«Cobren ánimo y ármense de valor, todos los que esperan en el Señor.» — Salmo 31:24\n\n' +
      'La Biblia habla de cobrar ánimo y tener valor, y en ti veo a una mujer increíblemente fuerte, que no se rinde y que afronta la vida con una entereza que me admira profundamente.\n\n' +
      '———\n\n' +
      'Cuando te conocí en 2023, llevabas un perfume que nunca voy a olvidar. Era algo muy bonito y sin igual, algo que me marcó desde el primer día. Me tomó mucho tiempo encontrar ese perfume — lo busqué con mucho desvelo — pero al fin lo hallé, y siempre, siempre lo voy a asociar contigo. Espero poder dártelo en algún momento..',
    insideEmoji: '🌸'
  },
  {
    id: 'miercoles',
    number: 2,
    date: '2026-09-30',
    dayName: 'Miércoles',
    dateLabel: '30 de Septiembre',
    title: 'Algo viene mañana...',
    frontMessage: 'Pronto descubrirás algo nuevo 💛',
    requiresPassword: false,
    insideTitle: 'Mensaje del día 2',
    insideMessage:
      '⚠️ EDITAR: Aquí va tu mensaje personalizado para el miércoles 30 de septiembre. Reemplaza este texto en src/pages/cumple.astro (array days, objeto miercoles).',
    insideEmoji: '✨'
  },
  {
    id: 'jueves',
    number: 3,
    date: '2026-10-01',
    dayName: 'Jueves',
    dateLabel: '1 de Octubre',
    title: 'Algo viene mañana...',
    frontMessage: 'Pronto descubrirás algo nuevo 💛',
    requiresPassword: false,
    insideTitle: 'Mensaje del día 3',
    insideMessage:
      '⚠️ EDITAR: Aquí va tu mensaje personalizado para el jueves 1 de octubre. Reemplaza este texto en src/pages/cumple.astro (array days, objeto jueves).',
    insideEmoji: '🌷'
  },
  {
    id: 'viernes',
    number: 4,
    date: '2026-10-02',
    dayName: 'Viernes',
    dateLabel: '2 de Octubre',
    title: 'Algo viene mañana...',
    frontMessage: 'Pronto descubrirás algo nuevo 💛',
    requiresPassword: false,
    insideTitle: 'Mensaje del día 4',
    insideMessage:
      '⚠️ EDITAR: Aquí va tu mensaje personalizado para el viernes 2 de octubre. Reemplaza este texto en src/pages/cumple.astro (array days, objeto viernes).',
    insideEmoji: '💫'
  },
  {
    id: 'sabado',
    number: 5,
    date: '2026-10-03',
    dayName: 'Sábado',
    dateLabel: '3 de Octubre',
    title: 'Mañana es tu día...',
    frontMessage: 'Mañana es un día muy especial. 🌻',
    requiresPassword: false,
    insideTitle: 'Mensaje del día 5',
    insideMessage:
      '⚠️ EDITAR: Aquí va tu mensaje personalizado para el sábado 3 de octubre. Reemplaza este texto en src/pages/cumple.astro (array days, objeto sabado).',
    insideEmoji: '🎁'
  },
  {
    id: 'domingo',
    number: 6,
    date: '2026-10-04',
    dayName: 'Domingo · Tu cumpleaños',
    dateLabel: '4 de Octubre',
    title: 'Feliz cumpleaños, Mariela',
    frontMessage: 'Hoy es tu día, mi amor. 🌻💛',
    requiresPassword: false,
    insideTitle: 'Feliz cumpleaños, Mariela',
    insideMessage:
      '⚠️ EDITAR: Aquí va tu mensaje personalizado para el domingo 4 de octubre (su cumpleaños). Reemplaza este texto en src/pages/cumple.astro (array days, objeto domingo).',
