---
/**
 * /juego — "Adivina el Héroe" · Edición Profesional
 * ---------------------------------------------------------
 * Quiz MOBA con emojis:
 *  · 10 preguntas: 3 emojis con pop escalonado + flotación.
 *  · Racha (🔥 xN) con bonus creciente y bonus por rapidez.
 *  · Confeti + puntos flotantes al acertar; shake del marco al fallar.
 *  · Medidor de bonus por rapidez (⚡ +50) como en un MOBA.
 *  · Bienvenida con Mariela en canvas (misma presentación que juego 4).
 *  · Dots de progreso verde/rojo por pregunta.
 *  · Estrellas 0–3 al final según aciertos + mejor puntaje
 *    guardado en localStorage.
 *  · Elección final de heroína favorita con tarjetas grandes.
 *
 * Resultado (heroína + puntaje) se guarda vía el Worker.
 */
---

<!doctype html>
<html lang="es" data-base-url={import.meta.env.BASE_URL}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5" />
    <meta name="theme-color" content="#15081F" />
    <title>Adivina el Héroe · Para Mariela 🎮</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="quiz-body">
    <div class="magic-dust" aria-hidden="true">
      {Array.from({ length: 32 }).map((_, i) => (
        <span
          class="dust"
          style={`top:${Math.random() * 100}%; left:${Math.random() * 100}%; animation-delay:${(Math.random() * 6).toFixed(2)}s; animation-duration:${(3 + Math.random() * 4).toFixed(2)}s;`}
        ></span>
      ))}
    </div>

    <main class="relative z-10 min-h-screen flex items-center justify-center px-4 py-6">
      <div class="quiz-frame" id="quiz-frame">

        {/* ============ PANTALLA 1: Bienvenida ============ */}
        <section id="screen-welcome" class="screen screen-active">
          <div class="welcome-badge">
            <span>🎮</span>
            <span>Mobile Legends · Quiz</span>
          </div>
          <h1 class="quiz-title">Adivina el Héroe</h1>
          <p class="quiz-subtitle">
            Tres emojis describen un rol de Mobile Legends
            (Tanque, Luchador, Asesino, Mago, Tirador o Soporte).
            <br />
            ¿Los reconoces como en el filtro del juego?
          </p>

          <div class="hero-presentation">
            <div class="hero-preview-wrap">
              <canvas id="hero-preview" width="140" height="150"></canvas>
              <div class="rune-orbit" aria-hidden="true">
                <span class="orbit-emoji" id="orbit-e1">🛡️</span>
                <span class="orbit-emoji" id="orbit-e2">🐢</span>
                <span class="orbit-emoji" id="orbit-e3">🧱</span>
              </div>
            </div>
            <p class="hero-caption">Mariela · Lectora de runas</p>
          </div>

          <div class="welcome-meta">
            <div class="meta-item">
              <span class="meta-num">10</span>
              <span class="meta-label">preguntas</span>
            </div>
            <div class="meta-sep">·</div>
            <div class="meta-item">
              <span class="meta-num">🔥</span>
              <span class="meta-label">rachas</span>
            </div>
            <div class="meta-sep">·</div>
            <div class="meta-item">
              <span class="meta-num">⭐</span>
              <span class="meta-label">hasta 3 estrellas</span>
            </div>
          </div>

          <div class="controls-preview">
            <div class="ctrl-item">
              <span class="ctrl-key">CLICK</span>
              <span class="ctrl-label">Responder</span>
            </div>
            <div class="ctrl-item">
              <span class="ctrl-key">🔥</span>
              <span class="ctrl-label">Racha bonus</span>
            </div>
            <div class="ctrl-item">
              <span class="ctrl-key">⚡</span>
              <span class="ctrl-label">Rapidez +50</span>
            </div>
          </div>

          <p class="best-score hidden" id="best-score-line">
            🏆 Tu mejor puntaje: <strong id="best-score-value">0</strong>
          </p>

          <button id="btn-start" type="button" class="game-btn">
            <span>Empezar el quiz</span>
            <span class="text-xl">⚔️</span>
          </button>
        </section>

        {/* ============ PANTALLA 2: Quiz ============ */}
        <section id="screen-game" class="screen">
          <div class="hud-top">
            <div class="hud-item">
              <span class="hud-label">Pregunta</span>
              <span class="hud-strong" id="hud-question">1 / 10</span>
            </div>
            <div class="hud-item">
              <span class="hud-label">Racha</span>
              <span class="hud-streak" id="hud-streak">—</span>
            </div>
            <div class="hud-item">
              <span class="hud-label">Puntaje</span>
              <span class="hud-strong hud-score" id="hud-score">0</span>
            </div>
          </div>

          <div class="progress-track">
            <div class="progress-fill" id="progress-fill"></div>
          </div>
          <div class="dots-row" id="dots-row"></div>

          <div class="speed-meter" id="speed-meter">
            <div class="speed-meter-head">
              <span class="speed-label">Bonus rapidez</span>
              <span class="speed-bonus-tag" id="speed-tag">⚡ +50</span>
            </div>
            <div class="speed-track">
              <div class="speed-fill" id="speed-fill"></div>
            </div>
          </div>

          <div class="rune-frame">
            <p class="rune-label">Esta runa describe a un héroe…</p>
            <div class="rune-emojis" id="rune-emojis">
              <span>🏹</span><span class="plus">+</span><span>🎯</span><span class="plus">+</span><span>📏</span>
            </div>
          </div>

          <p class="options-label">¿Qué rol de ML es?</p>
          <div class="options-grid" id="options-grid"></div>

          <div class="feedback hidden" id="feedback"></div>
        </section>

        {/* ============ PANTALLA 3: Heroína favorita ============ */}
        <section id="screen-final" class="screen">
          <div class="welcome-badge">
            <span>👑</span>
            <span>Última pregunta</span>
          </div>
          <h2 class="quiz-title">Y tu heroína favorita es…</h2>
          <p class="quiz-subtitle">
            La que más sientes que eres tú cuando juegas.
          </p>
          <div class="heroine-grid" id="heroine-grid"></div>
        </section>

        {/* ============ PANTALLA 4: Resultado ============ */}
        <section id="screen-result" class="screen">
          <div class="result-crown" id="result-crown">🎮</div>
          <div class="stars-row" id="stars-row">
            <span class="star">★</span><span class="star">★</span><span class="star">★</span>
          </div>
          <p class="game-stamp" id="result-stamp">Resultado</p>
          <h2 class="quiz-title" id="result-heroine">—</h2>

          <div class="score-board">
            <div class="stat-row">
              <span class="stat-label">Puntaje</span>
              <span class="stat-value" id="stat-score">0</span>
            </div>
            <div class="stat-row">
              <span class="stat-label">Aciertos</span>
              <span class="stat-value" id="stat-correct">0 / 10</span>
            </div>
            <div class="stat-row">
              <span class="stat-label">Mejor racha</span>
              <span class="stat-value" id="stat-streak">0</span>
            </div>
          </div>

          <div class="dots-row result-dots" id="result-dots"></div>

          <p class="result-message" id="result-message"></p>

          <div class="result-footer">
            <span class="line"></span>
            <span class="font-script text-2xl text-amber-300">Con amor, Andy</span>
            <span class="line"></span>
          </div>

          <p class="new-best hidden" id="new-best">🏆 ¡Nuevo mejor puntaje!</p>
          <p class="result-note">💛 Guardé tu resultado en un lugar especial.</p>

          <a href={`${import.meta.env.BASE_URL}juego4`} class="btn-play-game mt-4">
            <span class="text-lg">🏹</span>
            <span>Jugar otra aventura</span>
            <span class="text-lg">⚔️</span>
          </a>
        </section>

      </div>
    </main>

    <style is:global>
      .quiz-body {
        margin: 0;
        min-height: 100vh;
        font-family: 'Inter', system-ui, sans-serif;
        color: #FFFCF2;
        background:
          radial-gradient(ellipse at 20% 0%, rgba(245, 176, 40, 0.16) 0%, transparent 55%),
          radial-gradient(ellipse at 85% 100%, rgba(124, 58, 237, 0.2) 0%, transparent 55%),
          linear-gradient(180deg, #15081F 0%, #241241 55%, #0F0820 100%);
        background-attachment: fixed;
        overflow-x: hidden;
      }

      .magic-dust { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
      .dust {
        position: absolute;
        width: 3px; height: 3px;
        background: #FFD466;
        border-radius: 50%;
        opacity: 0;
        box-shadow: 0 0 8px rgba(255, 212, 102, 0.9);
        animation: floatDust 6s ease-in-out infinite;
      }
      @keyframes floatDust {
        0%, 100% { opacity: 0; transform: translateY(0) scale(0.5); }
        50% { opacity: 0.75; transform: translateY(-30px) scale(1.3); }
      }

      .quiz-frame {
        width: 100%;
        max-width: 720px;
        background: linear-gradient(135deg, rgba(45, 27, 78, 0.88) 0%, rgba(24, 13, 43, 0.88) 100%);
        border: 1px solid rgba(255, 212, 102, 0.32);
        border-radius: 26px;
        padding: clamp(22px, 4.5vw, 44px);
        box-shadow:
          0 1px 0 rgba(255, 255, 255, 0.08) inset,
          0 34px 90px -24px rgba(0, 0, 0, 0.75),
          0 0 90px rgba(168, 85, 247, 0.12);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        text-align: center;
        position: relative;
        overflow: hidden;
      }
      .quiz-frame.is-shaking {
        animation: frameShake 0.48s cubic-bezier(0.36, 0.07, 0.19, 0.97);
      }
      @keyframes frameShake {
        0%, 100% { transform: translate(0, 0) rotate(0deg); }
        15% { transform: translate(-5px, 2px) rotate(-0.4deg); }
        30% { transform: translate(5px, -2px) rotate(0.4deg); }
        45% { transform: translate(-4px, 1px) rotate(-0.3deg); }
        60% { transform: translate(4px, -1px) rotate(0.3deg); }
      }
      .quiz-frame::before {
        content: '';
        position: absolute;
        inset: 1px;
        border-radius: 25px;
        border: 1px solid rgba(255, 212, 102, 0.14);
        pointer-events: none;
      }

      .screen { display: none; animation: screenIn 0.5s cubic-bezier(0.4, 0, 0.2, 1); }
      .screen-active { display: block; }
      @keyframes screenIn {
        from { opacity: 0; transform: translateY(22px) scale(0.985); }
        to { opacity: 1; transform: translateY(0) scale(1); }
      }

      .font-script { font-family: 'Cormorant Garamond', Georgia, serif; }
      .mt-4 { margin-top: 16px; }

      .welcome-badge, .game-stamp {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 16px;
        border: 1px dashed rgba(255, 212, 102, 0.4);
        border-radius: 999px;
        color: #FFD466;
        font-size: 11px;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        margin-bottom: 18px;
      }

      .quiz-title {
        font-family: 'Cinzel', serif;
        font-size: clamp(28px, 5vw, 40px);
        font-weight: 700;
        background: linear-gradient(120deg, #FFD466 0%, #F5B028 45%, #A855F7 100%);
        background-size: 220% auto;
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        margin: 0 0 12px;
        line-height: 1.15;
        animation: shimmerTitle 4s linear infinite;
      }
      @keyframes shimmerTitle {
        from { background-position: 0% center; }
        to { background-position: 220% center; }
      }

      .quiz-subtitle {
        font-family: 'Cormorant Garamond', serif;
        font-style: italic;
        font-size: clamp(15px, 2.4vw, 18px);
        color: rgba(255, 252, 242, 0.88);
        line-height: 1.55;
        margin: 0 0 24px;
      }

      /* Presentación Mariela (welcome) — alineado con juego 4 */
      .hero-presentation {
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-bottom: 16px;
      }
      .hero-preview-wrap {
        position: relative;
        width: 140px;
        height: 150px;
      }
      #hero-preview {
        width: 140px;
        height: 150px;
        filter: drop-shadow(0 10px 26px rgba(255, 212, 102, 0.35));
      }
      .rune-orbit {
        position: absolute;
        inset: -8px -18px;
        pointer-events: none;
      }
      .orbit-emoji {
        position: absolute;
        font-size: 22px;
        filter: drop-shadow(0 3px 10px rgba(240, 171, 252, 0.55));
        animation: emojiFloat 3s ease-in-out infinite;
      }
      .orbit-emoji:nth-child(1) { top: 8px; left: -4px; animation-delay: 0s; }
      .orbit-emoji:nth-child(2) { top: 42px; right: -8px; animation-delay: 0.35s; }
      .orbit-emoji:nth-child(3) { bottom: 18px; left: 6px; animation-delay: 0.7s; }
      .hero-caption {
        font-family: 'Cinzel', serif;
        font-size: 12px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: rgba(255, 212, 102, 0.85);
        margin: 8px 0 0;
      }

      .controls-preview {
        display: flex;
        gap: 10px;
        justify-content: center;
        flex-wrap: wrap;
        margin-bottom: 14px;
      }
      .ctrl-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 7px 14px;
        background: rgba(255, 252, 242, 0.045);
        border: 1px solid rgba(255, 212, 102, 0.22);
        border-radius: 999px;
        font-size: 12px;
      }
      .ctrl-key {
        font-family: 'Cinzel', serif;
        font-weight: 700;
        color: #FFD466;
        letter-spacing: 0.05em;
      }
      .ctrl-label { color: rgba(255, 252, 242, 0.75); font-size: 11px; }

      @keyframes emojiPop {
        from { opacity: 0; transform: scale(0.2) rotate(-18deg); }
        to { opacity: 1; transform: scale(1) rotate(0deg); }
      }
      @keyframes emojiFloat {
        0%, 100% { transform: translateY(0) rotate(0deg); }
        50% { transform: translateY(-7px) rotate(3deg); }
      }

      .welcome-meta {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        margin-bottom: 14px;
        flex-wrap: wrap;
      }
      .meta-item { display: flex; align-items: center; gap: 7px; }
      .meta-num { font-family: 'Cinzel', serif; font-weight: 700; color: #FFD466; font-size: 16px; }
      .meta-label { font-size: 12px; color: rgba(255, 252, 242, 0.72); }
      .meta-sep { color: rgba(240, 171, 252, 0.6); }

      .best-score {
        font-size: 13px;
        color: rgba(255, 212, 102, 0.9);
        margin: 0 0 14px;
      }
      .best-score strong { font-family: 'Cinzel', serif; }

      .game-btn, .btn-play-game {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 15px 36px;
        border-radius: 999px;
        border: none;
        background: linear-gradient(135deg, #FFD466 0%, #F5B028 100%);
        color: #2D1B4E;
        font-family: 'Cinzel', serif;
        font-weight: 700;
        font-size: 15px;
        letter-spacing: 0.04em;
        cursor: pointer;
        box-shadow: 0 12px 34px -10px rgba(245, 176, 40, 0.6);
        transition: transform 0.25s, box-shadow 0.25s;
        text-decoration: none;
      }
      .game-btn:hover, .btn-play-game:hover {
        transform: translateY(-2px);
        box-shadow: 0 16px 42px -10px rgba(245, 176, 40, 0.75);
      }

      /* ============ HUD del quiz ============ */
      .hud-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
        gap: 8px;
      }
      .hud-item { text-align: center; }
      .hud-label {
        font-size: 10px;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: rgba(255, 212, 102, 0.72);
        display: block;
        margin-bottom: 4px;
      }
      .hud-strong {
        font-family: 'Cinzel', serif;
        font-weight: 700;
        font-size: 17px;
        color: #FFD466;
      }
      .hud-streak {
        font-family: 'Cinzel', serif;
        font-weight: 700;
        font-size: 17px;
        color: rgba(255, 252, 242, 0.55);
        display: inline-block;
        transition: color 0.2s, transform 0.2s;
      }
      .hud-streak.is-hot {
        color: #FB923C;
        text-shadow: 0 0 14px rgba(251, 146, 60, 0.8);
        animation: streakPulse 1.1s ease-in-out infinite;
      }
      @keyframes streakPulse {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.12); }
      }
      .hud-score { transition: transform 0.2s; }
      .hud-score.is-bump { animation: scoreBump 0.4s ease-out; }
      @keyframes scoreBump {
        0% { transform: scale(1); }
        40% { transform: scale(1.35); color: #F0ABFC; }
        100% { transform: scale(1); }
      }

      .progress-track {
        height: 7px;
        background: rgba(255, 252, 242, 0.08);
        border-radius: 999px;
        overflow: hidden;
        margin-bottom: 8px;
      }
      .progress-fill {
        height: 100%;
        width: 0%;
        background: linear-gradient(90deg, #FFD466 0%, #F5B028 60%, #A855F7 100%);
        border-radius: 999px;
        transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 0 14px rgba(255, 212, 102, 0.55);
      }

      .dots-row {
        display: flex;
        justify-content: center;
        gap: 6px;
        margin-bottom: 18px;
        flex-wrap: wrap;
      }
      .q-dot {
        width: 9px; height: 9px;
        border-radius: 50%;
        background: rgba(255, 252, 242, 0.16);
        transition: transform 0.25s, background 0.25s, box-shadow 0.25s;
      }
      .q-dot.is-current {
        transform: scale(1.5);
        background: #F0ABFC;
        box-shadow: 0 0 10px rgba(240, 171, 252, 0.8);
      }
      .q-dot.is-right { background: #4ADE80; box-shadow: 0 0 8px rgba(74, 222, 128, 0.6); }
      .q-dot.is-wrong { background: #EF4444; box-shadow: 0 0 8px rgba(239, 68, 68, 0.6); }

      .speed-meter {
        margin-bottom: 12px;
        padding: 0 4px;
      }
      .speed-meter-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 5px;
      }
      .speed-label {
        font-size: 10px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: rgba(255, 212, 102, 0.72);
      }
      .speed-bonus-tag {
        font-family: 'Cinzel', serif;
        font-size: 11px;
        font-weight: 700;
        color: rgba(255, 252, 242, 0.45);
        transition: color 0.2s, text-shadow 0.2s;
      }
      .speed-bonus-tag.is-active {
        color: #FBBF24;
        text-shadow: 0 0 12px rgba(251, 191, 36, 0.75);
      }
      .speed-track {
        height: 6px;
        background: rgba(255, 252, 242, 0.08);
        border-radius: 999px;
        overflow: hidden;
      }
      .speed-fill {
        height: 100%;
        width: 100%;
        background: linear-gradient(90deg, #FBBF24 0%, #F0ABFC 100%);
        border-radius: 999px;
        transition: width 0.08s linear;
        box-shadow: 0 0 12px rgba(251, 191, 36, 0.45);
      }
      .speed-fill.is-hot {
        box-shadow: 0 0 16px rgba(240, 171, 252, 0.65);
      }

      /* Runa de emojis */
      .rune-frame {
        background:
          radial-gradient(circle at 50% 50%, rgba(245, 176, 40, 0.16) 0%, transparent 70%),
          rgba(255, 252, 242, 0.04);
        border: 2px solid rgba(255, 212, 102, 0.28);
        border-radius: 20px;
        padding: 26px 20px;
        position: relative;
        margin-bottom: 16px;
      }
      .rune-frame::before, .rune-frame::after {
        content: '✦';
        position: absolute;
        top: 12px;
        color: rgba(255, 212, 102, 0.6);
        font-size: 13px;
      }
      .rune-frame::before { left: 15px; }
      .rune-frame::after { right: 15px; }

      .rune-label {
        font-family: 'Cormorant Garamond', serif;
        font-style: italic;
        color: rgba(255, 252, 242, 0.78);
        font-size: 14px;
        margin: 0 0 14px;
      }
      .rune-emojis {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        font-size: clamp(42px, 9vw, 58px);
        filter: drop-shadow(0 4px 18px rgba(255, 212, 102, 0.4));
        min-height: 74px;
      }
      .rune-emojis span {
        display: inline-block;
        animation: emojiPop 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) backwards,
                  emojiFloat 3s ease-in-out 0.6s infinite;
      }
      .rune-emojis span:nth-child(1) { animation-delay: 0.05s, 0.65s; }
      .rune-emojis span:nth-child(3) { animation-delay: 0.16s, 0.76s; }
      .rune-emojis span:nth-child(5) { animation-delay: 0.27s, 0.87s; }
      .rune-emojis .plus {
        font-size: 24px;
        color: rgba(240, 171, 252, 0.85);
        font-family: 'Cinzel', serif;
        animation: none;
      }

      .options-label {
        font-size: 11px;
        letter-spacing: 0.26em;
        text-transform: uppercase;
        color: rgba(255, 252, 242, 0.66);
        margin: 0 0 12px;
      }

      .options-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
      }
      @media (max-width: 480px) { .options-grid { grid-template-columns: 1fr; } }

      .option-btn {
        position: relative;
        padding: 14px 12px;
        background: rgba(255, 252, 242, 0.05);
        border: 1.5px solid rgba(255, 212, 102, 0.26);
        border-radius: 13px;
        color: #FFFCF2;
        font-family: 'Inter', sans-serif;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.22s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-align: center;
      }
      .option-btn:hover:not(:disabled) {
        background: rgba(245, 176, 40, 0.14);
        border-color: rgba(255, 212, 102, 0.6);
        transform: translateY(-2px);
      }
      .option-btn:disabled { cursor: not-allowed; }
      .option-btn.is-correct {
        background: linear-gradient(135deg, rgba(74, 222, 128, 0.28) 0%, rgba(34, 197, 94, 0.28) 100%);
        border-color: #4ADE80;
        animation: correctPulse 0.55s ease-out;
      }
      .option-btn.is-wrong {
        background: rgba(239, 68, 68, 0.16);
        border-color: rgba(239, 68, 68, 0.6);
        animation: wrongShake 0.4s;
      }
      .option-btn .check-icon {
        position: absolute;
        top: -7px; right: -6px;
        width: 22px; height: 22px;
        border-radius: 50%;
        background: #4ADE80;
        color: #052e16;
        font-size: 13px;
        font-weight: 900;
        display: none;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 8px rgba(74, 222, 128, 0.6);
      }
      .option-btn.is-correct .check-icon { display: flex; }
      @keyframes correctPulse {
        0% { transform: scale(1); }
        45% { transform: scale(1.05); box-shadow: 0 0 26px rgba(74, 222, 128, 0.55); }
        100% { transform: scale(1); }
      }
      @keyframes wrongShake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-5px); }
        75% { transform: translateX(5px); }
      }

      .feedback {
        margin-top: 14px;
        padding: 11px 15px;
        border-radius: 12px;
        font-family: 'Cormorant Garamond', serif;
        font-style: italic;
        font-size: 15px;
        text-align: center;
        animation: fadeIn 0.35s ease-out;
      }
      .feedback.correct {
        background: rgba(74, 222, 128, 0.13);
        border: 1px solid rgba(74, 222, 128, 0.32);
        color: #BBF7D0;
      }
      .feedback.wrong {
        background: rgba(245, 176, 40, 0.13);
        border: 1px solid rgba(245, 176, 40, 0.32);
        color: #FFD466;
      }
      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(-8px); }
        to { opacity: 1; transform: translateY(0); }
      }

      /* Partículas de confeti (DOM) */
      .spark-particle {
        position: absolute;
        width: 7px; height: 7px;
        border-radius: 50%;
        pointer-events: none;
        z-index: 60;
        animation: sparkFly 0.85s ease-out forwards;
      }
      @keyframes sparkFly {
        from { transform: translate(0, 0) scale(1); opacity: 1; }
        to { transform: translate(var(--dx), var(--dy)) scale(0.15); opacity: 0; }
      }

      /* Puntos flotantes (+150) */
      .float-pts {
        position: absolute;
        font-family: 'Cinzel', serif;
        font-weight: 700;
        font-size: 17px;
        color: #FFD466;
        text-shadow: 0 2px 6px rgba(10, 5, 20, 0.9);
        pointer-events: none;
        z-index: 60;
        animation: ptsFloat 0.95s ease-out forwards;
      }
      @keyframes ptsFloat {
        from { opacity: 0; transform: translateY(6px) scale(0.8); }
        25% { opacity: 1; }
        to { opacity: 0; transform: translateY(-44px) scale(1.15); }
      }

      /* ============ Heroínas ============ */
      .heroine-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 11px;
        margin-top: 20px;
      }
      @media (min-width: 560px) { .heroine-grid { grid-template-columns: repeat(3, 1fr); } }

      .heroine-btn {
        padding: 18px 10px;
        background: rgba(255, 252, 242, 0.045);
        border: 1.5px solid rgba(255, 212, 102, 0.25);
        border-radius: 15px;
        color: #FFFCF2;
        font-family: 'Cinzel', serif;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.25s;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        position: relative;
        overflow: hidden;
      }
      .heroine-btn::before {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 50% 0%, var(--role-glow, rgba(255, 212, 102, 0.25)) 0%, transparent 70%);
        opacity: 0;
        transition: opacity 0.3s;
      }
      .heroine-btn:hover {
        transform: translateY(-4px);
        border-color: #FFD466;
        box-shadow: 0 10px 26px -8px rgba(245, 176, 40, 0.55);
      }
      .heroine-btn:hover::before { opacity: 1; }
      .heroine-emoji { font-size: 30px; position: relative; }
      .heroine-role {
        font-size: 9.5px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: rgba(255, 212, 102, 0.72);
        position: relative;
      }
      .role-tiradora { --role-glow: rgba(74, 222, 128, 0.3); }
      .role-maga { --role-glow: rgba(168, 85, 247, 0.35); }
      .role-apoyo { --role-glow: rgba(236, 72, 153, 0.3); }
      .role-asesina { --role-glow: rgba(239, 68, 68, 0.3); }
      .role-luchador { --role-glow: rgba(245, 158, 11, 0.3); }

      /* ============ Resultado ============ */
      .result-crown {
        font-size: clamp(44px, 10vw, 56px);
        line-height: 1;
        margin-bottom: 4px;
        filter: drop-shadow(0 6px 20px rgba(255, 212, 102, 0.45));
        animation: crownBob 2.8s ease-in-out infinite;
      }
      @keyframes crownBob {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-5px); }
      }

      .stars-row {
        font-size: 44px;
        letter-spacing: 6px;
        margin-bottom: 8px;
        filter: drop-shadow(0 4px 16px rgba(255, 212, 102, 0.5));
      }
      .star { color: rgba(255, 252, 242, 0.16); display: inline-block; }
      .star.is-on {
        color: #FFD466;
        animation: starPop 0.55s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
      }
      .star.is-on:nth-child(2) { animation-delay: 0.18s; }
      .star.is-on:nth-child(3) { animation-delay: 0.36s; }
      @keyframes starPop {
        from { transform: scale(0.2) rotate(-40deg); opacity: 0; }
        to { transform: scale(1) rotate(0deg); opacity: 1; }
      }

      .score-board {
        background: rgba(255, 252, 242, 0.045);
        border: 1px solid rgba(255, 212, 102, 0.2);
        border-radius: 14px;
        padding: 12px 20px;
        margin: 16px 0 10px;
      }
      .stat-row {
        display: flex;
        justify-content: space-between;
        padding: 7px 0;
        font-size: 13px;
        color: rgba(255, 252, 242, 0.88);
        border-bottom: 1px solid rgba(255, 212, 102, 0.09);
      }
      .stat-row:last-child { border-bottom: none; }
      .stat-label {
        color: rgba(255, 212, 102, 0.8);
        font-size: 11px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
      }
      .stat-value { font-family: 'Cinzel', serif; font-weight: 700; color: #FFD466; }

      .result-dots { margin: 4px 0 14px; }

      .result-message {
        font-family: 'Cormorant Garamond', serif;
        font-style: italic;
        font-size: clamp(15px, 2.4vw, 18px);
        line-height: 1.62;
        color: rgba(255, 252, 242, 0.92);
        margin: 14px 0 6px;
        padding: 0 6px;
      }
      .result-footer {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        margin: 14px 0;
      }
      .result-footer .line {
        flex: 1;
        max-width: 60px;
        height: 1px;
        background: linear-gradient(90deg, transparent, #FFD466, transparent);
      }
      .new-best {
        font-size: 13px;
        color: #F0ABFC;
        font-weight: 600;
        margin: 6px 0;
      }
      .result-note {
        font-size: 12px;
        color: rgba(255, 252, 242, 0.62);
        font-style: italic;
        margin: 0 0 4px;
      }
      .hidden { display: none !important; }
    </style>

    <script>
      // ============================================================
      // DATOS
      // ============================================================
      type HeroQuestion = {
        emojis: string[];
        answer: string;
        options: string[];
        hint: string;
      };

      type Heroine = { name: string; role: string; roleClass: string; emoji: string };

      // Roles oficiales MLBB (filtro de héroes en español): Tanque, Luchador,
      // Asesino, Mago, Tirador, Soporte.
      const questions: HeroQuestion[] = [
        { emojis: ['🛡️', '🐢', '🧱'], answer: 'Tanque',
          options: ['Tanque', 'Mago', 'Asesino', 'Soporte'],
          hint: 'Rol Tanque: aguanta daño, abre pelea y protege al carry (roam o EXP)' },
        { emojis: ['🧙‍♀️', '🔮', '💥'], answer: 'Mago',
          options: ['Tirador', 'Mago', 'Luchador', 'Soporte'],
          hint: 'Rol Mago: burst mágico y control desde mid lane' },
        { emojis: ['🏹', '🎯', '📏'], answer: 'Tirador',
          options: ['Tanque', 'Soporte', 'Tirador', 'Mago'],
          hint: 'Rol Tirador (marksman): farmea gold lane y daño físico a distancia' },
        { emojis: ['🗡️', '🌑', '💨'], answer: 'Asesino',
          options: ['Mago', 'Asesino', 'Tanque', 'Tirador'],
          hint: 'Rol Asesino: jungla o pick, entra y elimina objetivos frágiles' },
        { emojis: ['💚', '➕', '🤝'], answer: 'Soporte',
          options: ['Soporte', 'Asesino', 'Luchador', 'Tirador'],
          hint: 'Rol Soporte: cura, escudo y utilidad para el equipo (roam)' },
        { emojis: ['🥊', '👊', '⚔️'], answer: 'Luchador',
          options: ['Tanque', 'Luchador', 'Mago', 'Soporte'],
          hint: 'Rol Luchador: pelea sostenida en EXP lane, daño y resistencia' },
        { emojis: ['❄️', '🌀', '⛓️'], answer: 'Mago',
          options: ['Tanque', 'Tirador', 'Luchador', 'Mago'],
          hint: 'Rol Mago: CC y control de zona en teamfight' },
        { emojis: ['🔥', '🥋', '💪'], answer: 'Luchador',
          options: ['Asesino', 'Luchador', 'Soporte', 'Tanque'],
          hint: 'Rol Luchador: duelos largos y presión en la sideline' },
        { emojis: ['🌩️', '🔥', '🌊'], answer: 'Mago',
          options: ['Tirador', 'Mago', 'Luchador', 'Asesino'],
          hint: 'Rol Mago: daño mágico por habilidades (no autoataque)' },
        { emojis: ['🐆', '⚡', '🗡️'], answer: 'Asesino',
          options: ['Tanque', 'Soporte', 'Asesino', 'Tirador'],
          hint: 'Rol Asesino: movilidad alta y burst para borrar carries' }
      ];

      const heroines: Heroine[] = [
        { name: 'Hanabi', role: 'Tirador', roleClass: 'role-tiradora', emoji: '🏹' },
        { name: 'Miya', role: 'Tirador', roleClass: 'role-tiradora', emoji: '🌟' },
        { name: 'Pharsa', role: 'Mago', roleClass: 'role-maga', emoji: '🔥' },
        { name: 'Luo Yi', role: 'Mago', roleClass: 'role-maga', emoji: '🌙' },
        { name: 'Estes', role: 'Soporte', roleClass: 'role-apoyo', emoji: '💚' },
        { name: 'Guinevere', role: 'Mago', roleClass: 'role-maga', emoji: '👸' },
        { name: 'Fanny', role: 'Asesino', roleClass: 'role-asesina', emoji: '🗡️' },
        { name: 'Kagura', role: 'Mago', roleClass: 'role-maga', emoji: '🧙‍♀️' },
        { name: 'Chou', role: 'Luchador', roleClass: 'role-luchador', emoji: '🥋' },
        { name: 'Angela', role: 'Soporte', roleClass: 'role-apoyo', emoji: '💖' }
      ];

      const heroineMessages: Record<string, string> = {
        Hanabi: 'Hanabi lanza sus flechas con una precisión increíble, llena de luz y de poder. Como tú cuando juegas: enfocada, segura, sin que nada te detenga.',
        Miya: 'Miya dispara desde lejos con paciencia y precisión. Clásica y elegante, como la esencia que llevas dentro.',
        Pharsa: 'Pharsa vuela sobre el campo de batalla con una vista que nadie más tiene. Como tú: siempre viendo las cosas desde otra perspectiva.',
        'Luo Yi': 'Luo Yi lee los astros y guía con magia antigua. Como tú: siempre conectada con lo que sientes, con esa intuición que no falla.',
        Estes: 'Estes es de los apoyos más nobles: curar sin esperar nada a cambio. Como tú con los que quieres.',
        Guinevere: 'Guinevere es elegante, poderosa y de corazón noble. Como tú, Mariela: fuerte por fuera, suave por dentro.',
        Fanny: 'Fanny es rápida, arriesgada y hace cosas que nadie más se atreve. Como tú.',
        Kagura: 'Kagura es mágica, llena de luz. Como la magia que le pusiste a mi vida.',
        Chou: 'Chou nunca se rinde, aguanta todo y vuelve más fuerte. Eso eres tú, Mariela.',
        Angela: 'Angela cuida, protege y da todo por los suyos. Como tú.'
      };

      // Puntaje
      const BASE_PTS = 100;
      const STREAK_STEP = 25;
      const STREAK_CAP = 100;
      const SPEED_BONUS = 50;
      const SPEED_TIME = 2.5; // segundos

      const CONFETTI = ['#FFD466', '#F0ABFC', '#A855F7', '#4ADE80', '#FBBF24'];

      // ============================================================
      // ESTADO
      // ============================================================
      const state = {
        qIndex: 0,
        score: 0,
        correct: 0,
        streak: 0,
        bestStreak: 0,
        results: [] as boolean[],
        qStart: performance.now(),
        heroine: ''
      };

      const total = questions.length;

      // ============================================================
      // DOM / PANTALLAS
      // ============================================================
      const screens: Record<string, HTMLElement | null> = {
        welcome: document.getElementById('screen-welcome'),
        game: document.getElementById('screen-game'),
        final: document.getElementById('screen-final'),
        result: document.getElementById('screen-result')
      };
      const showScreen = (name: string) => {
        Object.values(screens).forEach((s) => s?.classList.remove('screen-active'));
        screens[name]?.classList.add('screen-active');
      };

      const frame = document.getElementById('quiz-frame')!;
      const runeEmojis = document.getElementById('rune-emojis')!;
      const optionsGrid = document.getElementById('options-grid')!;
      const feedbackEl = document.getElementById('feedback')!;
      const progressFill = document.getElementById('progress-fill')!;
      const dotsRow = document.getElementById('dots-row')!;
      const resultDots = document.getElementById('result-dots')!;
      const hudQuestion = document.getElementById('hud-question')!;
      const hudStreak = document.getElementById('hud-streak')!;
      const hudScore = document.getElementById('hud-score')!;
      const speedFill = document.getElementById('speed-fill')!;
      const speedTag = document.getElementById('speed-tag')!;

      const BEST_KEY = 'mlquiz_best_v1';
      let speedRaf = 0;

      // ============================================================
      // EFECTOS (confeti + puntos flotantes)
      // ============================================================
      function confettiBurst(x: number, y: number, count = 16) {
        for (let i = 0; i < count; i++) {
          const el = document.createElement('span');
          el.className = 'spark-particle';
          const angle = (Math.PI * 2 * i) / count + Math.random() * 0.5;
          const dist = 55 + Math.random() * 60;
          el.style.left = `${x}px`;
          el.style.top = `${y}px`;
          el.style.setProperty('--dx', `${Math.cos(angle) * dist}px`);
          el.style.setProperty('--dy', `${Math.sin(angle) * dist}px`);
          el.style.background = CONFETTI[i % CONFETTI.length];
          el.style.width = el.style.height = `${5 + Math.random() * 5}px`;
          frame.appendChild(el);
          window.setTimeout(() => el.remove(), 900);
        }
      }

      function floatPts(x: number, y: number, text: string) {
        const el = document.createElement('span');
        el.className = 'float-pts';
        el.textContent = text;
        el.style.left = `${x}px`;
        el.style.top = `${y}px`;
        frame.appendChild(el);
        window.setTimeout(() => el.remove(), 1000);
      }

      function frameCenterOf(el: HTMLElement) {
        const fr = frame.getBoundingClientRect();
        const r = el.getBoundingClientRect();
        return { x: r.left - fr.left + r.width / 2, y: r.top - fr.top + r.height / 2 };
      }

      // ============================================================
      // DOTS DE PROGRESO
      // ============================================================
      function buildDots() {
        dotsRow.innerHTML = questions.map(() => '<span class="q-dot"></span>').join('');
        syncDots(dotsRow);
      }

      function syncDots(row: HTMLElement) {
        row.querySelectorAll<HTMLElement>('.q-dot').forEach((d, i) => {
          d.classList.remove('is-current', 'is-right', 'is-wrong');
          if (state.results[i] === true) d.classList.add('is-right');
          else if (state.results[i] === false) d.classList.add('is-wrong');
          else if (i === state.qIndex && row === dotsRow) d.classList.add('is-current');
        });
      }

      // ============================================================
      // HUD
      // ============================================================
      function updateHUD() {
        hudQuestion.textContent = `${Math.min(state.qIndex + 1, total)} / ${total}`;
        hudScore.textContent = String(state.score);
        if (state.streak >= 2) {
          hudStreak.textContent = `🔥 x${state.streak}`;
          hudStreak.classList.add('is-hot');
        } else {
          hudStreak.textContent = '—';
          hudStreak.classList.remove('is-hot');
        }
        progressFill.style.width = `${(state.qIndex / total) * 100}%`;
      }

      function bumpScore() {
        hudScore.classList.remove('is-bump');
        void hudScore.offsetWidth; // reinicia animación
        hudScore.classList.add('is-bump');
      }

      function shakeFrame() {
        frame.classList.remove('is-shaking');
        void frame.offsetWidth;
        frame.classList.add('is-shaking');
        window.setTimeout(() => frame.classList.remove('is-shaking'), 500);
      }

      function stopSpeedMeter() {
        if (speedRaf) cancelAnimationFrame(speedRaf);
        speedRaf = 0;
      }

      function startSpeedMeter() {
        stopSpeedMeter();
        speedFill.style.width = '100%';
        speedFill.classList.add('is-hot');
        speedTag.classList.add('is-active');

        const tick = () => {
          const elapsed = (performance.now() - state.qStart) / 1000;
          const remaining = Math.max(0, 1 - elapsed / SPEED_TIME);
          speedFill.style.width = `${remaining * 100}%`;
          speedFill.classList.toggle('is-hot', remaining > 0.2);
          speedTag.classList.toggle('is-active', remaining > 0);

          if (
            remaining > 0 &&
            screens.game?.classList.contains('screen-active') &&
            state.qIndex < total
          ) {
            speedRaf = requestAnimationFrame(tick);
          } else {
            speedRaf = 0;
            if (remaining <= 0) speedFill.style.width = '0%';
          }
        };
        speedRaf = requestAnimationFrame(tick);
      }

      // ============================================================
      // RENDER DE PREGUNTA
      // ============================================================
      function renderQuestion() {
        const q = questions[state.qIndex];
        state.qStart = performance.now();

        // Emojis con pop escalonado (se regeneran → reinicia animación)
        runeEmojis.innerHTML =
          `<span>${q.emojis[0]}</span><span class="plus">+</span>` +
          `<span>${q.emojis[1]}</span><span class="plus">+</span>` +
          `<span>${q.emojis[2]}</span>`;

        // Opciones (barajadas)
        const opts = [...q.options].sort(() => Math.random() - 0.5);
        optionsGrid.innerHTML = opts
          .map(
            (o) => `
            <button type="button" class="option-btn" data-value="${o}">
              <span>${o}</span>
              <span class="check-icon">✓</span>
            </button>`
          )
          .join('');

        feedbackEl.className = 'feedback hidden';
        feedbackEl.textContent = '';

        optionsGrid.querySelectorAll<HTMLButtonElement>('.option-btn').forEach((btn) => {
          btn.addEventListener('click', () => handleAnswer(btn, q));
        });

        updateHUD();
        syncDots(dotsRow);
        startSpeedMeter();
      }

      // ============================================================
      // RESPUESTA
      // ============================================================
      function handleAnswer(btn: HTMLButtonElement, q: HeroQuestion) {
        stopSpeedMeter();
        const allBtns = optionsGrid.querySelectorAll<HTMLButtonElement>('.option-btn');
        allBtns.forEach((b) => (b.disabled = true));

        const isCorrect = btn.dataset.value === q.answer;
        const elapsed = (performance.now() - state.qStart) / 1000;
        let gained = 0;
        let parts: string[] = [];

        if (isCorrect) {
          state.correct++;
          state.streak++;
          state.bestStreak = Math.max(state.bestStreak, state.streak);
          state.results[state.qIndex] = true;

          gained += BASE_PTS;
          parts.push(`+${BASE_PTS}`);

          if (state.streak >= 2) {
            const bonus = Math.min(STREAK_STEP * (state.streak - 1), STREAK_CAP);
            gained += bonus;
            parts.push(`🔥 +${bonus}`);
          }
          if (elapsed <= SPEED_TIME) {
            gained += SPEED_BONUS;
            parts.push('⚡ +50');
          }
          state.score += gained;

          btn.classList.add('is-correct');
          feedbackEl.textContent = `✨ ¡Correcto! ${q.hint}`;
          feedbackEl.className = 'feedback correct';

          // Efectos
          const pos = frameCenterOf(btn);
          confettiBurst(pos.x, pos.y, 18);
          floatPts(pos.x, pos.y - 26, `+${gained}`);
          bumpScore();
        } else {
          state.streak = 0;
          state.results[state.qIndex] = false;
          btn.classList.add('is-wrong');
          const correctBtn = Array.from(allBtns).find((b) => b.dataset.value === q.answer);
          if (correctBtn) correctBtn.classList.add('is-correct');
          feedbackEl.textContent = `😅 Casi… era “${q.answer}”. ${q.hint}`;
          feedbackEl.className = 'feedback wrong';
          shakeFrame();
        }

        feedbackEl.classList.remove('hidden');
        updateHUD();
        syncDots(dotsRow);

        window.setTimeout(() => {
          state.qIndex++;
          if (state.qIndex < total) {
            renderQuestion();
          } else {
            progressFill.style.width = '100%';
            renderHeroines();
            showScreen('final');
          }
        }, 1900);
      }

      // ============================================================
      // HEROÍNAS
      // ============================================================
      function renderHeroines() {
        const grid = document.getElementById('heroine-grid')!;
        grid.innerHTML = heroines
          .map(
            (h) => `
            <button type="button" class="heroine-btn ${h.roleClass}" data-name="${h.name}" data-role="${h.role}">
              <span class="heroine-emoji">${h.emoji}</span>
              <span>${h.name}</span>
              <span class="heroine-role">${h.role}</span>
            </button>`
          )
          .join('');

        grid.querySelectorAll<HTMLButtonElement>('.heroine-btn').forEach((b) => {
          b.addEventListener('click', () => {
            state.heroine = b.dataset.name || '';
            showResult();
          });
        });
      }

      // ============================================================
      // RESULTADO
      // ============================================================
      function starsFor(correct: number): number {
        if (correct >= 9) return 3;
        if (correct >= 7) return 2;
        if (correct >= 5) return 1;
        return 0;
      }

      function showResult() {
        const stars = starsFor(state.correct);

        // Estrellas
        const starsRow = document.getElementById('stars-row')!;
        starsRow.querySelectorAll<HTMLElement>('.star').forEach((s, i) => {
          s.classList.toggle('is-on', i < stars);
        });

        // Sello y título
        const stamp = document.getElementById('result-stamp')!;
        stamp.textContent =
          stars === 3 ? '¡Perfecto!' : stars === 2 ? '¡Muy bien!' : stars === 1 ? '¡Bien!' : 'Resultado';

        const crown = document.getElementById('result-crown')!;
        crown.textContent = stars === 3 ? '🏆' : stars === 2 ? '⭐' : stars === 1 ? '👑' : '💪';

        const titleEl = document.getElementById('result-heroine')!;
        const h = heroines.find((x) => x.name === state.heroine);
        titleEl.textContent = h ? `${h.name} · ${h.role}` : '—';

        // Stats
        (document.getElementById('stat-score')!).textContent = String(state.score);
        (document.getElementById('stat-correct')!).textContent = `${state.correct} / ${total}`;
        (document.getElementById('stat-streak')!).textContent = `🔥 x${state.bestStreak}`;

        // Review dots
        resultDots.innerHTML = state.results
          .map((ok) => `<span class="q-dot ${ok ? 'is-right' : 'is-wrong'}"></span>`)
          .join('');

        // Mensaje
        const msg =
          heroineMessages[state.heroine] ||
          `Elegiste a ${state.heroine}. Si es tu favorita, ya me cae bien. 💛`;
        (document.getElementById('result-message')!).textContent = msg;

        // Mejor puntaje (localStorage)
        let best = 0;
        try { best = parseInt(localStorage.getItem(BEST_KEY) || '0', 10) || 0; } catch { best = 0; }
        const newBest = state.score > best;
        if (newBest) {
          try { localStorage.setItem(BEST_KEY, String(state.score)); } catch { /* noop */ }
        }
        document.getElementById('new-best')!.classList.toggle('hidden', !newBest);
        updateBestLine();

        // Confeti si 3 estrellas
        if (stars === 3) {
          const r = frame.getBoundingClientRect();
          confettiBurst(r.width / 2, r.height * 0.25, 30);
          window.setTimeout(() => confettiBurst(r.width * 0.25, r.height * 0.4, 20), 220);
          window.setTimeout(() => confettiBurst(r.width * 0.75, r.height * 0.4, 20), 380);
        }

        showScreen('result');
        sendToWorker();
      }

      function updateBestLine() {
        let best = 0;
        try { best = parseInt(localStorage.getItem(BEST_KEY) || '0', 10) || 0; } catch { best = 0; }
        const line = document.getElementById('best-score-line')!;
        const val = document.getElementById('best-score-value')!;
        if (best > 0) {
          val.textContent = String(best);
          line.classList.remove('hidden');
        } else {
          line.classList.add('hidden');
        }
      }

      // ============================================================
      // WORKER
      // ============================================================
      const workerUrl = 'https://mariela-responses.andyguzman117.workers.dev';
      async function sendToWorker() {
        try {
          const fd = new FormData();
          fd.set('Respuesta', `Heroína favorita: ${state.heroine}`);
          fd.set('Mensaje', `Puntaje quiz: ${state.score} | Aciertos: ${state.correct}/10 | Mejor racha: x${state.bestStreak}`);
          await fetch(workerUrl, { method: 'POST', body: fd, headers: { Accept: 'application/json' } });
        } catch (err) {
          console.warn('No se pudo guardar:', err);
        }
      }

      // ============================================================
      // DEMO (welcome): runas orbitando alrededor de Mariela
      // ============================================================
      function startOrbitDemo() {
        const e1 = document.getElementById('orbit-e1')!;
        const e2 = document.getElementById('orbit-e2')!;
        const e3 = document.getElementById('orbit-e3')!;
        let i = 0;
        const tick = () => {
          const q = questions[i % questions.length];
          i++;
          [e1, e2, e3].forEach((el, k) => {
            el.textContent = q.emojis[k];
            el.style.animation = 'none';
            void el.offsetWidth;
            el.style.animation = '';
          });
        };
        tick();
        window.setInterval(tick, 2400);
      }

      // ============================================================
      // PREVIEW MARIELA (canvas — misma figura que juego 4)
      // ============================================================
      function drawHeroPreview() {
        const pc = document.getElementById('hero-preview') as HTMLCanvasElement | null;
        if (!pc) return;
        const pctx = pc.getContext('2d')!;
        const pdpr = Math.min(2, window.devicePixelRatio || 1);
        pc.width = 140 * pdpr;
        pc.height = 150 * pdpr;
        pctx.setTransform(pdpr, 0, 0, pdpr, 0, 0);

        const draw = () => {
          const t = performance.now() / 1000;
          pctx.clearRect(0, 0, 140, 150);

          pctx.fillStyle = 'rgba(92, 58, 30, 0.6)';
          pctx.beginPath(); pctx.ellipse(70, 132, 34, 7, 0, 0, Math.PI * 2); pctx.fill();

          const aura = pctx.createRadialGradient(70, 70, 8, 70, 70, 72);
          aura.addColorStop(0, 'rgba(168, 85, 247, 0.25)');
          aura.addColorStop(0.6, 'rgba(255, 212, 102, 0.2)');
          aura.addColorStop(1, 'rgba(255, 212, 102, 0)');
          pctx.fillStyle = aura;
          pctx.fillRect(0, 0, 140, 150);

          pctx.save();
          pctx.translate(70, 76 + Math.sin(t * 2.2) * 1.6);
          pctx.scale(1.15, 1.15);

          const skirtSway = Math.sin(t * 2.2) * 1.6;
          const hairSway = Math.sin(t * 2) * 1.6;

          const cape = pctx.createLinearGradient(-16, -14, -26, 24);
          cape.addColorStop(0, '#8B5CF6'); cape.addColorStop(1, '#5B21B6');
          pctx.fillStyle = cape;
          pctx.beginPath();
          pctx.moveTo(-13, -14);
          pctx.quadraticCurveTo(-21, 2, -18 - Math.sin(t * 1.8) * 2, 22);
          pctx.quadraticCurveTo(-6, 25, 12, 22);
          pctx.lineTo(13, -14);
          pctx.closePath(); pctx.fill();

          const dress = pctx.createLinearGradient(0, -14, 0, 28);
          dress.addColorStop(0, '#FCD34D'); dress.addColorStop(0.65, '#F5B028'); dress.addColorStop(1, '#B45309');
          pctx.fillStyle = dress;
          pctx.beginPath();
          pctx.moveTo(-10, -12); pctx.lineTo(10, -12);
          pctx.quadraticCurveTo(13 + skirtSway, 8, 11 + skirtSway, 26);
          pctx.quadraticCurveTo(0, 30, -11 + skirtSway * 0.6, 26);
          pctx.quadraticCurveTo(-13 + skirtSway * 0.6, 8, -10, -12);
          pctx.closePath(); pctx.fill();
          pctx.strokeStyle = '#92400E'; pctx.lineWidth = 1.5; pctx.stroke();

          pctx.fillStyle = '#A56B0E';
          pctx.fillRect(-8, 26, 6, 6);
          pctx.fillRect(3, 26, 6, 6);
          pctx.fillStyle = '#451A03';
          pctx.fillRect(-9, 30, 8, 3);
          pctx.fillRect(2, 30, 8, 3);

          pctx.strokeStyle = '#6D28D9'; pctx.lineWidth = 2.4;
          pctx.beginPath(); pctx.moveTo(-10, -2); pctx.lineTo(10, -2); pctx.stroke();
          pctx.fillStyle = '#F0ABFC';
          pctx.beginPath(); pctx.arc(0, -2, 2.4, 0, Math.PI * 2); pctx.fill();

          pctx.fillStyle = '#451A03';
          pctx.beginPath(); pctx.ellipse(0, -18, 11.5, 10.5, 0, 0, Math.PI * 2); pctx.fill();

          pctx.fillStyle = '#FEF3C7';
          pctx.strokeStyle = '#D97706'; pctx.lineWidth = 1.4;
          pctx.beginPath(); pctx.arc(0, -20, 10.5, 0, Math.PI * 2); pctx.fill(); pctx.stroke();

          pctx.fillStyle = '#451A03';
          pctx.beginPath();
          pctx.arc(0, -23, 10.8, Math.PI * 0.95, Math.PI * 2.05);
          pctx.quadraticCurveTo(6, -24, 8 - hairSway * 0.4, -18);
          pctx.quadraticCurveTo(4, -14, 2, -22);
          pctx.quadraticCurveTo(-2, -24, -6, -22);
          pctx.quadraticCurveTo(-9, -20, -10.5, -17);
          pctx.quadraticCurveTo(-11, -22, -8, -25);
          pctx.closePath(); pctx.fill();

          pctx.fillStyle = '#FFD466';
          pctx.strokeStyle = '#B45309'; pctx.lineWidth = 1.2;
          pctx.fillRect(-9.5, -33, 19, 4.6);
          pctx.strokeRect(-9.5, -33, 19, 4.6);
          pctx.beginPath();
          pctx.moveTo(-9.5, -33); pctx.lineTo(-6.5, -38.5); pctx.lineTo(-3.5, -33);
          pctx.lineTo(0, -39.5); pctx.lineTo(3.5, -33);
          pctx.lineTo(6.5, -38.5); pctx.lineTo(9.5, -33);
          pctx.closePath(); pctx.fill(); pctx.stroke();
          pctx.fillStyle = '#DC2626';
          pctx.beginPath(); pctx.arc(0, -35.5, 2.4, 0, Math.PI * 2); pctx.fill();

          pctx.fillStyle = '#1F2937';
          pctx.beginPath();
          pctx.ellipse(-3.6, -20, 1.9, 2.4, 0, 0, Math.PI * 2);
          pctx.ellipse(3.6, -20, 1.9, 2.4, 0, 0, Math.PI * 2);
          pctx.fill();
          pctx.fillStyle = '#FFFCF2';
          pctx.beginPath(); pctx.arc(-3, -21, 0.8, 0, Math.PI * 2); pctx.arc(4.2, -21, 0.8, 0, Math.PI * 2); pctx.fill();
          pctx.fillStyle = 'rgba(244, 114, 182, 0.4)';
          pctx.beginPath(); pctx.arc(-6.4, -16.6, 2.4, 0, Math.PI * 2); pctx.arc(6.4, -16.6, 2.4, 0, Math.PI * 2); pctx.fill();
          pctx.strokeStyle = '#7C2D12'; pctx.lineWidth = 1.3; pctx.lineCap = 'round';
          pctx.beginPath(); pctx.arc(0, -17, 3.2, 0.3, Math.PI - 0.3); pctx.stroke();

          // pergamino / runa en lugar del arco (tema quiz)
          pctx.save();
          pctx.translate(8, -8);
          pctx.rotate(0.15 + Math.sin(t * 1.4) * 0.06);
          pctx.fillStyle = '#FFFCF2';
          pctx.strokeStyle = '#D97706'; pctx.lineWidth = 1.2;
          pctx.fillRect(-2, -10, 16, 20);
          pctx.strokeRect(-2, -10, 16, 20);
          pctx.fillStyle = '#F0ABFC';
          pctx.font = '11px serif';
          pctx.fillText('?', 4, 2);
          pctx.restore();

          pctx.restore();
          requestAnimationFrame(draw);
        };
        draw();
      }

      // ============================================================
      // INICIO
      // ============================================================
      document.getElementById('btn-start')?.addEventListener('click', () => {
        state.qIndex = 0;
        state.score = 0;
        state.correct = 0;
        state.streak = 0;
        state.bestStreak = 0;
        state.results = [];
        state.heroine = '';
        buildDots();
        updateHUD();
        renderQuestion();
        showScreen('game');
      });

      updateBestLine();
      buildDots();
      startOrbitDemo();
      drawHeroPreview();
    </script>
  </body>
</html>
