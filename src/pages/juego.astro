---
/**
 * /juego — Mini-juego Mobile Legends temático (VERSIÓN ÉPICA)
 * ------------------------------------------------------------
 * Ronda 1: "Reconocé los items ML" — 6 preguntas con SVGs
 *          de objetos del juego (escudo, espada, staff, etc.)
 * Ronda 2: "Adivina el héroe" — 8 preguntas con emojis
 * Final: "¿Cuál es tu heroína favorita?"
 *
 * Estilo MOBA con colores del juego. Cada respuesta se guarda
 * en el repo (vía Worker) para que Andy vea qué eligió.
 */
---

<!doctype html>
<html lang="es" data-base-url={import.meta.env.BASE_URL}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5" />
    <meta name="theme-color" content="#1A0F2E" />
    <title>Adivina el Héroe · Para Mariela 🎮</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="game-body">
    <div class="magic-dust" aria-hidden="true">
      {Array.from({ length: 50 }).map((_, i) => (
        <span
          class="dust"
          style={`top:${Math.random() * 100}%; left:${Math.random() * 100}%; animation-delay:${Math.random() * 5}s; animation-duration:${3 + Math.random() * 4}s;`}
        ></span>
      ))}
    </div>

    <main class="relative z-10 min-h-screen flex items-center justify-center px-4 py-6">
      <div class="game-frame">

        {/* ============ PANTALLA 1: Bienvenida ============ */}
        <section id="screen-welcome" class="screen screen-active">
          <div class="welcome-badge">
            <span>🎮</span>
            <span>Mobile Legends Adventure</span>
          </div>
          <h1 class="game-title">Adivina el Héroe</h1>
          <p class="game-subtitle">
            2 rondas, 14 preguntas y una sorpresa final.
            <br />
            ¿Lista para la aventura, Mariela?
          </p>
          <div class="round-preview">
            <div class="round-preview-item">
              <span class="round-num">🎮</span>
              <span class="round-label">Adivina el héroe</span>
              <span class="round-count">10 preguntas con emojis</span>
            </div>
          </div>
          <button id="btn-start" type="button" class="game-btn">
            <span>Empezar</span>
            <span class="text-xl">⚔️</span>
          </button>
        </section>

        {/* ============ PANTALLA 2: Juego ============ */}
        <section id="screen-game" class="screen">
          <div class="game-progress">
            <div class="progress-info">
              <span class="round-label-top">Adivina el héroe</span>
              <span id="round-counter" class="round-counter">Pregunta 1 / 10</span>
            </div>
            <div class="progress-track">
              <div id="progress-fill" class="progress-fill"></div>
            </div>
          </div>

          {/* Emojis */}
          <div id="rune-container" class="rune-container">
            <div class="rune-frame">
              <p class="rune-label">Esta runa mágica representa al héroe:</p>
              <div id="rune-emojis" class="rune-emojis"></div>
            </div>
          </div>

          <p class="options-label">Elegí una opción</p>
          <div id="options-grid" class="options-grid"></div>

          <div id="feedback" class="feedback hidden"></div>
        </section>

        {/* ============ PANTALLA 4: Pregunta final ============ */}
        <section id="screen-final" class="screen">
          <div class="game-stamp">Última pregunta</div>
          <h2 class="game-title">Y tu heroína favorita es...</h2>
          <p class="game-subtitle">
            Elegí la que más te guste. La que más sientes que eres tú.
          </p>
          <div id="heroine-grid" class="heroine-grid"></div>
        </section>

        {/* ============ PANTALLA 5: Resultado ============ */}
        <section id="screen-result" class="screen">
          <div class="result-crown">👑</div>
          <p class="game-stamp">Tu elección</p>
          <h2 id="result-title" class="game-title"></h2>
          <p id="result-message" class="result-message"></p>
          <div class="result-footer">
            <span class="line"></span>
            <span class="font-script text-2xl text-amber-300">Con amor, Andy</span>
            <span class="line"></span>
          </div>
          <p class="result-stats">
            🏆 Puntaje total: <strong id="final-score">0</strong> /
            <strong id="final-total">14</strong>
          </p>
          <p class="result-note">💛 Guardé tu resultado en un lugar especial.</p>
          <a href={`${import.meta.env.BASE_URL}juego4`} class="btn-play-game mt-5">
            <span class="text-lg">🏹</span>
            <span>Jugar otra aventura</span>
            <span class="text-lg">⚔️</span>
          </a>
        </section>

      </div>
    </main>

    <style is:global>
      .game-body {
        margin: 0;
        min-height: 100vh;
        font-family: 'Inter', system-ui, sans-serif;
        color: #FFFCF2;
        background:
          radial-gradient(ellipse at 20% 0%, rgba(245, 176, 40, 0.18) 0%, transparent 55%),
          radial-gradient(ellipse at 80% 100%, rgba(138, 43, 226, 0.20) 0%, transparent 55%),
          linear-gradient(180deg, #1A0F2E 0%, #2D1B4E 50%, #0F0820 100%);
        background-attachment: fixed;
        overflow-x: hidden;
      }

      .magic-dust { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
      .dust {
        position: absolute;
        width: 3px; height: 3px;
        background: #FFD466;
        border-radius: 50%;
        opacity: 0;
        box-shadow: 0 0 6px rgba(255, 212, 102, 0.8);
        animation: floatDust 6s ease-in-out infinite;
      }
      @keyframes floatDust {
        0%, 100% { opacity: 0; transform: translateY(0) scale(0.5); }
        50% { opacity: 0.9; transform: translateY(-30px) scale(1.4); }
      }

      .game-frame {
        width: 100%;
        max-width: 760px;
        background: linear-gradient(135deg, rgba(45, 27, 78, 0.85) 0%, rgba(26, 15, 46, 0.85) 100%);
        border: 1px solid rgba(255, 212, 102, 0.35);
        border-radius: 28px;
        padding: clamp(24px, 5vw, 48px);
        box-shadow:
          0 1px 0 rgba(255, 255, 255, 0.1) inset,
          0 30px 80px -20px rgba(0, 0, 0, 0.7),
          0 0 80px rgba(245, 176, 40, 0.15);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        position: relative;
        text-align: center;
      }

      .screen { display: none; animation: screenIn 0.5s cubic-bezier(0.4, 0, 0.2, 1); }
      .screen-active { display: block; }
      @keyframes screenIn {
        from { opacity: 0; transform: translateY(20px) scale(0.98); }
        to { opacity: 1; transform: translateY(0) scale(1); }
      }

      .font-script { font-family: 'Cormorant Garamond', Georgia, serif; }

      .game-stamp, .welcome-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 14px;
        border: 1px dashed rgba(255, 212, 102, 0.4);
        border-radius: 999px;
        color: #FFD466;
        font-size: 11px;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        margin-bottom: 18px;
      }

      .game-title {
        font-family: 'Cinzel', serif;
        font-size: clamp(28px, 5vw, 40px);
        font-weight: 700;
        background: linear-gradient(120deg, #FFD466 0%, #F5B028 50%, #FFD466 100%);
        background-size: 200% auto;
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        margin: 0 0 16px;
        line-height: 1.15;
        animation: shimmerTitle 3s linear infinite;
      }
      @keyframes shimmerTitle {
        from { background-position: 0% center; }
        to { background-position: 200% center; }
      }

      .game-subtitle {
        font-family: 'Cormorant Garamond', serif;
        font-style: italic;
        font-size: clamp(15px, 2.4vw, 18px);
        color: rgba(255, 252, 242, 0.85);
        line-height: 1.5;
        margin: 0 0 28px;
      }

      .round-preview {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        margin-bottom: 24px;
        flex-wrap: wrap;
      }
      .round-preview-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        padding: 10px 14px;
        background: rgba(255, 212, 102, 0.1);
        border: 1px solid rgba(255, 212, 102, 0.3);
        border-radius: 12px;
        min-width: 120px;
      }
      .round-num {
        font-family: 'Cinzel', serif;
        font-weight: 700;
        font-size: 16px;
        color: #FFD466;
      }
      .round-label {
        font-size: 11px;
        font-weight: 600;
        color: #FFFCF2;
      }
      .round-count {
        font-size: 10px;
        color: rgba(255, 252, 242, 0.6);
        letter-spacing: 0.05em;
      }
      .round-divider-arrow {
        font-size: 28px;
        color: #FFD466;
        filter: drop-shadow(0 0 8px rgba(255, 212, 102, 0.6));
      }

      .round-intor-badge {
        display: inline-block;
        padding: 8px 18px;
        border-radius: 999px;
        background: linear-gradient(135deg, #FFD466 0%, #F5B028 100%);
        color: #2D1B4E;
        font-family: 'Cinzel', serif;
        font-weight: 700;
        font-size: 14px;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        margin-bottom: 18px;
        box-shadow: 0 4px 16px -4px rgba(245, 176, 40, 0.5);
      }

      .game-btn, .btn-play-game {
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 16px 36px;
        border-radius: 999px;
        border: none;
        background: linear-gradient(135deg, #FFD466 0%, #F5B028 100%);
        color: #2D1B4E;
        font-family: 'Cinzel', serif;
        font-weight: 600;
        font-size: 15px;
        letter-spacing: 0.05em;
        cursor: pointer;
        box-shadow: 0 10px 30px -8px rgba(245, 176, 40, 0.55);
        transition: transform 0.25s, box-shadow 0.25s;
        text-decoration: none;
      }
      .game-btn:hover, .btn-play-game:hover {
        transform: translateY(-2px);
        box-shadow: 0 14px 36px -8px rgba(245, 176, 40, 0.7);
      }

      .game-btn { margin-top: 8px; }

      .game-progress {
        margin-bottom: 22px;
      }
      .progress-info {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 8px;
      }
      .round-label-top {
        font-family: 'Cinzel', serif;
        font-weight: 600;
        font-size: 14px;
        color: #FFD466;
      }
      .round-counter {
        font-size: 11px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: rgba(255, 252, 242, 0.7);
      }
      .progress-track {
        height: 6px;
        background: rgba(255, 252, 242, 0.1);
        border-radius: 999px;
        overflow: hidden;
      }
      .progress-fill {
        height: 100%;
        width: 0%;
        background: linear-gradient(90deg, #FFD466 0%, #F5B028 100%);
        border-radius: 999px;
        transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 0 12px rgba(255, 212, 102, 0.6);
      }

      /* Item display (Ronda 1) */
            /* Rune (emojis del héroe) */


      .rune-container {
        margin-bottom: 22px;
      }
      .rune-frame {
        background:
          radial-gradient(circle at 50% 50%, rgba(245, 176, 40, 0.15) 0%, transparent 70%),
          rgba(255, 252, 242, 0.04);
        border: 1px solid rgba(255, 212, 102, 0.25);
        border-radius: 20px;
        padding: 28px 24px;
      }
      .rune-frame::before, .rune-frame::after {
        content: '✦';
        position: absolute;
        top: 12px;
        color: rgba(255, 212, 102, 0.6);
        font-size: 12px;
      }
      .rune-frame::before { left: 14px; }
      .rune-frame::after { right: 14px; }
      .rune-label {
        font-family: 'Cormorant Garamond', serif;
        font-style: italic;
        color: rgba(255, 252, 242, 0.75);
        font-size: 14px;
        margin: 0 0 12px;
        text-align: center;
      }
      .rune-emojis {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        font-size: clamp(40px, 9vw, 56px);
        filter: drop-shadow(0 4px 16px rgba(255, 212, 102, 0.4));
      }
      .rune-emojis span {
        animation: runeFloat 3s ease-in-out infinite;
      }
      .rune-emojis span:nth-child(2) { animation-delay: 0.3s; }
      .rune-emojis span:nth-child(3) { animation-delay: 0.6s; }
      @keyframes runeFloat {
        0%, 100% { transform: translateY(0) rotate(0deg); }
        50% { transform: translateY(-6px) rotate(3deg); }
      }

      .options-label {
        font-size: 12px;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: rgba(255, 252, 242, 0.7);
        margin: 0 0 12px;
      }
      .options-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
      }
      @media (max-width: 480px) {
        .options-grid { grid-template-columns: 1fr; }
      }

      .option-btn {
        position: relative;
        padding: 14px 12px;
        background: rgba(255, 252, 242, 0.06);
        border: 1.5px solid rgba(255, 212, 102, 0.25);
        border-radius: 12px;
        color: #FFFCF2;
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.25s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-align: center;
      }
      .option-btn:hover:not(:disabled) {
        background: rgba(245, 176, 40, 0.15);
        border-color: rgba(255, 212, 102, 0.6);
        transform: translateY(-2px);
      }
      .option-btn:disabled { cursor: not-allowed; opacity: 0.6; }
      .option-btn.is-correct {
        background: linear-gradient(135deg, rgba(74, 222, 128, 0.3) 0%, rgba(34, 197, 94, 0.3) 100%);
        border-color: #4ADE80;
        color: #FFFCF2;
        animation: correctPulse 0.6s ease-out;
      }
      .option-btn.is-wrong {
        background: rgba(239, 68, 68, 0.18);
        border-color: rgba(239, 68, 68, 0.5);
        animation: wrongShake 0.4s;
      }
      @keyframes correctPulse {
        0% { transform: scale(1); }
        50% { transform: scale(1.06); box-shadow: 0 0 20px rgba(74, 222, 128, 0.5); }
        100% { transform: scale(1); }
      }
      @keyframes wrongShake {
        0%, 100% { transform: translateX(0); }
        25% { transform: translateX(-4px); }
        75% { transform: translateX(4px); }
      }

      .feedback {
        margin-top: 16px;
        padding: 12px 16px;
        border-radius: 12px;
        font-family: 'Cormorant Garamond', serif;
        font-style: italic;
        font-size: 14px;
        text-align: center;
        animation: fadeIn 0.4s ease-out;
      }
      .feedback.correct {
        background: rgba(74, 222, 128, 0.15);
        border: 1px solid rgba(74, 222, 128, 0.3);
        color: #BBF7D0;
      }
      .feedback.wrong {
        background: rgba(245, 176, 40, 0.15);
        border: 1px solid rgba(245, 176, 40, 0.3);
        color: #FFD466;
      }
      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(-8px); }
        to { opacity: 1; transform: translateY(0); }
      }

      /* Heroínas */
      .heroine-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
        margin-top: 22px;
      }
      @media (min-width: 600px) {
        .heroine-grid { grid-template-columns: repeat(3, 1fr); }
      }
      .heroine-btn {
        padding: 16px 10px;
        background: rgba(255, 252, 242, 0.05);
        border: 1.5px solid rgba(255, 212, 102, 0.25);
        border-radius: 14px;
        color: #FFFCF2;
        font-family: 'Cinzel', serif;
        font-size: 13px;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.25s;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
      }
      .heroine-btn:hover {
        background: rgba(245, 176, 40, 0.15);
        border-color: #FFD466;
        transform: translateY(-3px);
        box-shadow: 0 8px 20px -8px rgba(245, 176, 40, 0.6);
      }
      .heroine-btn .role {
        font-size: 10px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: rgba(255, 212, 102, 0.7);
      }

      /* Resultado */
      .result-crown {
        font-size: 60px;
        margin-bottom: 8px;
        animation: crownFloat 3s ease-in-out infinite;
        filter: drop-shadow(0 4px 16px rgba(255, 212, 102, 0.5));
      }
      @keyframes crownFloat {
        0%, 100% { transform: translateY(0) rotate(-3deg); }
        50% { transform: translateY(-6px) rotate(3deg); }
      }
      .result-message {
        font-family: 'Cormorant Garamond', serif;
        font-style: italic;
        font-size: clamp(15px, 2.4vw, 18px);
        line-height: 1.65;
        color: rgba(255, 252, 242, 0.92);
        margin: 16px 0 8px;
        padding: 0 6px;
      }
      .result-stats {
        font-family: 'Cinzel', serif;
        font-size: 14px;
        color: #FFD466;
        margin: 10px 0;
      }
      .result-stats strong {
        font-size: 18px;
        color: #FFFCF2;
      }
      .result-footer {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        margin: 14px 0;
      }
      .result-footer .line {
        flex: 1;
        max-width: 60px;
        height: 1px;
        background: linear-gradient(90deg, transparent, #FFD466, transparent);
      }
      .result-note {
        font-size: 12px;
        color: rgba(255, 252, 242, 0.6);
        font-style: italic;
        margin: 0 0 14px;
      }
      .btn-play-game { margin: 14px auto 0; }
    </style>

    <script>
      // =========================================================
      // Datos del juego
      // =========================================================
      type HeroQuestion = {
        emojis: string[];
        answer: string;
        options: string[];
        hint: string;
      };

      type Heroine = {
        name: string;
        role: string;
        emoji: string;
      };

      const heroesRound: HeroQuestion[] = [
        { emojis: ['🛡️', '💪', '⚔️'], answer: 'Tank',
          options: ['Tank', 'Maga', 'Asesina', 'Apoyo'],
          hint: 'Defiende al equipo y aguanta todo el daño' },
        { emojis: ['🧙‍♀️', '🔮', '✨'], answer: 'Maga',
          options: ['Arquera', 'Maga', 'Luchadora', 'Apoyo'],
          hint: 'Lanza hechizos devastadores desde lejos' },
        { emojis: ['🏹', '🌿', '👁️'], answer: 'Tirador',
          options: ['Tank', 'Apoyo', 'Tirador', 'Maga'],
          hint: 'Ataca desde lejos con precisión mortal' },
        { emojis: ['🗡️', '🌙', '⚡'], answer: 'Asesina',
          options: ['Maga', 'Asesina', 'Tank', 'Tirador'],
          hint: 'Rápida, letal y aparece de la nada' },
        { emojis: ['💖', '🌸', '🤲'], answer: 'Apoyo',
          options: ['Apoyo', 'Asesina', 'Luchadora', 'Tirador'],
          hint: 'Cura al equipo y lo hace más fuerte' },
        { emojis: ['🥋', '👊', '🔥'], answer: 'Luchador',
          options: ['Tank', 'Luchador', 'Maga', 'Apoyo'],
          hint: 'Cuerpo a cuerpo, no se rinde nunca' },
        { emojis: ['❄️', '🌊', '🐉'], answer: 'Maga',
          options: ['Tank', 'Tirador', 'Luchador', 'Maga'],
          hint: 'Congela y controla a los enemigos' },
        { emojis: ['🌺', '⚔️', '🛡️'], answer: 'Luchador',
          options: ['Asesina', 'Luchador', 'Apoyo', 'Tank'],
          hint: 'Ataca con espadas y poderes de tierra' },
        { emojis: ['👑', '💫', '✨'], answer: 'Maga',
          options: ['Tirador', 'Maga', 'Luchador', 'Asesina'],
          hint: 'Controla el tiempo y los elementos' },
        { emojis: ['🐺', '⚡', '🌙'], answer: 'Asesina',
          options: ['Tank', 'Apoyo', 'Asesina', 'Tirador'],
          hint: 'Salta entre sombras y ataca por sorpresa' }
      ];

      const heroines: Heroine[] = [
        { name: 'Hanabi', role: 'Tiradora', emoji: '🏹💥' },
        { name: 'Miya', role: 'Tiradora', emoji: '🌟🏹' },
        { name: 'Pharsa', role: 'Maga', emoji: '🔥🦅' },
        { name: 'Luo Yi', role: 'Maga', emoji: '🌙🧧' },
        { name: 'Estes', role: 'Apoyo', emoji: '💚🌿' },
        { name: 'Guinevere', role: 'Maga', emoji: '👸✨' },
        { name: 'Fanny', role: 'Asesina', emoji: '🗡️💨' },
        { name: 'Kagura', role: 'Maga', emoji: '🧙‍♀️🔮' },
        { name: 'Chou', role: 'Luchador', emoji: '🥋⚡' },
        { name: 'Angela', role: 'Apoyo', emoji: '💖🌸' }
      ];

      const baseUrl = document.documentElement.dataset.baseUrl || '/mariela/';
      const workerUrl = 'https://mariela-responses.andyguzman117.workers.dev';

      // =========================================================
      // Estado del juego
      // =========================================================
      let questionIndex = 0;
      let score = 0;
      const totalQuestions = heroesRound.length;

      const screens = {
        welcome: document.getElementById('screen-welcome')!,
        game: document.getElementById('screen-game')!,
        final: document.getElementById('screen-final')!,
        result: document.getElementById('screen-result')!
      };

      const showScreen = (name: keyof typeof screens) => {
        Object.values(screens).forEach((s) => s.classList.remove('screen-active'));
        screens[name].classList.add('screen-active');
      };

      // ---------- Inicio ----------
      document.getElementById('btn-start')?.addEventListener('click', () => {
        questionIndex = 0;
        score = 0;
        showScreen('game');
        renderQuestion();
      });

      // ---------- Renderizar pregunta ----------
      const renderQuestion = () => {
        const q = heroesRound[questionIndex];
        const total = heroesRound.length;

        // Progreso
        const fillEl = document.getElementById('progress-fill') as HTMLElement;
        const roundCounter = document.getElementById('round-counter');
        if (roundCounter) roundCounter.textContent = `Pregunta ${questionIndex + 1} / ${total}`;
        if (fillEl) fillEl.style.width = `${(questionIndex / total) * 100}%`;

        // Mostrar los 3 emojis
        const runeEmojis = document.getElementById('rune-emojis');
        if (runeEmojis) runeEmojis.innerHTML = q.emojis.map((e) => `<span>${e}</span>`).join(' + ');

        // Renderizar opciones
        const grid = document.getElementById('options-grid')!;
        const feedbackEl = document.getElementById('feedback')!;
        if (feedbackEl) {
          feedbackEl.classList.add('hidden');
          feedbackEl.classList.remove('correct', 'wrong');
          feedbackEl.textContent = '';
        }
        grid.innerHTML = q.options
          .map(
            (opt) => `
            <button type="button" class="option-btn" data-value="${opt}">
              <span>${opt}</span>
            </button>
          `
          )
          .join('');

        grid.querySelectorAll<HTMLButtonElement>('.option-btn').forEach((btn) => {
          btn.addEventListener('click', () => handleAnswer(btn, q.answer, q.hint));
        });
      };

      // ---------- Manejar respuesta ----------
      const handleAnswer = (btn: HTMLButtonElement, answer: string, hint: string) => {
        const feedbackEl = document.getElementById('feedback')!;
        const allBtns = document.querySelectorAll<HTMLButtonElement>('.option-btn');
        allBtns.forEach((b) => (b.disabled = true));

        const isCorrect = btn.dataset.value === answer;
        if (isCorrect) {
          score++;
          btn.classList.add('is-correct');
          feedbackEl.textContent = `✨ ¡Correcto! ${hint}`;
          feedbackEl.classList.add('correct');
        } else {
          btn.classList.add('is-wrong');
          const correctBtn = Array.from(allBtns).find((b) => b.dataset.value === answer);
          if (correctBtn) correctBtn.classList.add('is-correct');
          feedbackEl.textContent = `😅 Casi... era "${answer}".`;
          feedbackEl.classList.add('wrong');
        }
        feedbackEl.classList.remove('hidden');

        window.setTimeout(() => {
          questionIndex++;
          if (questionIndex < heroesRound.length) {
            renderQuestion();
          } else {
            // Terminó: pasa a la pregunta final
            showScreen('final');
            renderHeroines();
            const fillEl = document.getElementById('progress-fill') as HTMLElement;
            if (fillEl) fillEl.style.width = '100%';
          }
        }, 1800);
      };

      // ---------- Héroínas ----------
      const renderHeroines = () => {
        const grid = document.getElementById('heroine-grid')!;
        grid.innerHTML = heroines
          .map(
            (h) => `
            <button type="button" class="heroine-btn" data-name="${h.name}" data-role="${h.role}">
              <span style="font-size:24px;">${h.emoji.split('')[0]}</span>
              <span>${h.name}</span>
              <span class="role">${h.role}</span>
            </button>
          `
          )
          .join('');

        grid.querySelectorAll<HTMLButtonElement>('.heroine-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            const name = btn.dataset.name!;
            const role = btn.dataset.role!;
            showResult(name, role);
          });
        });
      };

      // ---------- Resultado ----------
      const showResult = (name: string, role: string) => {
        const messages: Record<string, string> = {
          Hanabi: 'Hanabi lanza sus flechas con una precisión increíble, llena de luz y de poder. Como tú cuando juegas: enfocada, segura, sin que nada te detenga.',
          Miya: 'Miya dispara desde lejos con precisión y paciencia. Clásica y elegante, como la esencia que llevás dentro.',
          Pharsa: 'Pharsa vuela sobre el campo de batalla con una vista que nadie más tiene. Como tú: siempre viendo las cosas desde otra perspectiva.',
          'Luo Yi': 'Luo Yi lee los astros y guía con magia antigua. Como tú: siempre conectada con lo que sientes, con esa intuición que no falla.',
          Estes: 'Estes es de los apoyos más nobles: curar sin esperar nada a cambio. Como tú con los que quieres.',
          Guinevere: 'Guinevere es elegante, poderosa y tiene un corazón noble. Como tú, Mariela: fuerte por fuera, suave por dentro.',
          Fanny: 'Fanny es rápida, arriesgada y hace cosas que nadie más se atreve. Como tú.',
          Kagura: 'Kagura es mágica, llena de luz. Como la magia que le pusiste a mi vida.',
          Chou: 'Chou nunca se rinde, aguanta todo y vuelve más fuerte. Eso eres tú, Mariela.',
          Angela: 'Angela cuida, protege y da todo por los suyos. Como tú.'
        };

        const message = messages[name] || `Elegiste a ${name}. Si es tu favorita, ya me cae bien. 💛`;
        const titleEl = document.getElementById('result-title');
        const msgEl = document.getElementById('result-message');
        const scoreEl = document.getElementById('final-score');
        const totalEl = document.getElementById('final-total');
        if (titleEl) titleEl.textContent = `${name}, ${role}`;
        if (msgEl) msgEl.textContent = message;
        if (scoreEl) scoreEl.textContent = String(score);
        if (totalEl) totalEl.textContent = String(totalQuestions);

        showScreen('result');
        sendToWorker(name, role);
      };

      // ---------- Enviar al Worker ----------
      const sendToWorker = async (heroina: string, rol: string) => {
        try {
          const formData = new FormData();
          formData.set('Respuesta', `Heroína favorita: ${heroina}`);
          formData.set('Mensaje', `Rol: ${rol} | Puntaje en el juego: ${score}/${totalQuestions}`);
          await fetch(workerUrl, {
            method: 'POST',
            body: formData,
            headers: { Accept: 'application/json' }
          });
        } catch (err) {
          console.warn('No se pudo guardar:', err);
        }
      };
    </script>
  </body>
</html>
