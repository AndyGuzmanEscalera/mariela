---
/**
 * /acai — Sorpresa del jueves
 * Tres etapas: memorizar el pedido, armar el bowl y acertar el drizzle.
 */
---

<!doctype html>
<html lang="es" data-base-url={import.meta.env.BASE_URL}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5" />
    <meta name="theme-color" content="#2b1236" />
    <title>Açaí Challenge · Para Mariela 💜</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>

  <body>
    <div class="ambient" aria-hidden="true">
      {Array.from({ length: 26 }).map(() => (
        <i style={`--x:${Math.random() * 100}%;--d:${(Math.random() * 8).toFixed(1)}s;--t:${(9 + Math.random() * 8).toFixed(1)}s`}></i>
      ))}
    </div>

    <main>
      <div class="shell">
        <section class="screen active" id="welcome">
          <div class="badge">💜 Sorpresa del jueves</div>
          <h1>Açaí Challenge</h1>
          <p class="lead">
            Memoriza un pedido secreto, encuentra los toppings correctos
            y demuestra tu precisión con el toque final.
          </p>

          <div class="hero-bowl" aria-hidden="true">
            <div class="hero-toppings">🥛 🍫 🍬 🥜 🥥</div>
            <div class="hero-base"></div>
            <div class="hero-cup"><span>Mariela</span><small>açaí bar</small></div>
          </div>

          <div class="stages">
            <div><b>1</b><span>Memoriza</span><small>7 toppings</small></div>
            <div><b>2</b><span>Construye</span><small>sin equivocarte</small></div>
            <div><b>3</b><span>Apunta</span><small>drizzle perfecto</small></div>
          </div>

          <button class="primary" id="start" type="button">Aceptar el reto <span>✨</span></button>
        </section>

        <section class="screen" id="memory">
          <div class="badge">Etapa 1 · Memoria</div>
          <h1>Memoriza el pedido</h1>
          <p class="lead">Tienes unos segundos. Después, la receta desaparecerá.</p>

          <div class="timer-ring" id="timer-ring"><strong id="countdown">6</strong><span>segundos</span></div>
          <div class="order-card">
            <p>Pedido secreto de Mariela</p>
            <div class="order-list" id="memory-list"></div>
          </div>

          <button class="secondary" id="skip-memory" type="button">Ya me la sé →</button>
        </section>

        <section class="screen" id="build">
          <header class="hud">
            <div><span>Encontrados</span><strong id="found">0 / 7</strong></div>
            <div class="hud-title">Arma el bowl</div>
            <div><span>Intentos</span><strong id="hearts">💜 💜 💜</strong></div>
          </header>
          <div class="progress"><i id="progress"></i></div>

          <div class="challenge-note">
            <span>🧠</span>
            <p><b>¿Recuerdas el pedido?</b><br />Arrastra al bowl solo los toppings correctos.</p>
            <button id="hint" type="button">Ver pista (<span id="hint-count">2</span>)</button>
          </div>

          <div class="build-grid">
            <div class="bowl-zone" id="bowl-zone" aria-label="Suelta los toppings aquí">
              <span class="drop-label">Suelta aquí</span>
              <div class="bowl-stack" id="bowl-stack"></div>
              <div class="bowl-rim"></div>
              <div class="bowl"><b>💛</b><span>MARIELA</span></div>
              <div class="shadow"></div>
            </div>

            <div class="pantry">
              <p>Barra de toppings</p>
              <div class="ingredients" id="ingredients"></div>
            </div>
          </div>

          <p class="feedback" id="feedback" aria-live="polite">
            También puedes tocar un topping para agregarlo.
          </p>
        </section>

        <section class="screen" id="drizzle">
          <div class="badge">Etapa 3 · Precisión</div>
          <h1>El toque final</h1>
          <p class="lead">Detén el marcador dentro de la zona dorada para lograr el drizzle perfecto.</p>

          <div class="drizzle-preview">
            <div class="sauce" id="sauce"></div>
            <div class="mini-toppings" id="mini-toppings"></div>
            <div class="mini-base"></div>
            <div class="mini-cup">AÇAÍ</div>
          </div>

          <div class="precision">
            <span class="precision-label">Precisión</span>
            <div class="meter">
              <div class="sweet-zone"></div>
              <i id="marker"></i>
            </div>
            <div class="meter-words"><span>Casi</span><b>¡Perfecto!</b><span>Casi</span></div>
          </div>

          <p class="feedback" id="precision-feedback">Tienes 3 intentos.</p>
          <button class="primary" id="pour" type="button">Agregar salsa ✨</button>
        </section>

        <section class="screen result" id="result">
          <div id="confetti" aria-hidden="true"></div>
          <div class="badge">🏆 Reto completado</div>
          <h1>¡Açaí perfecto!</h1>

          <div class="final-bowl">
            <div class="final-toppings" id="final-toppings"></div>
            <div class="final-drizzle">〰 〰 〰</div>
            <div class="final-base"></div>
            <div class="final-cup"><b>Mariela</b><small>hecho con cariño</small></div>
          </div>

          <div class="prize">
            <span>🎁</span>
            <small>Premio desbloqueado</small>
            <h2>Te ganaste un açaí</h2>
            <p>Espero poder dártelo pronto. 💜</p>
          </div>

          <p class="closing">
            Gracias por enseñarme sabores nuevos y por convertir nuestras primeras veces
            en recuerdos especiales.
          </p>
          <div class="signature"><i></i><em>Con cariño, Andy</em><i></i></div>
          <button class="secondary" id="again" type="button">Jugar otra vez ↻</button>
        </section>
      </div>
    </main>

    <div class="hint-overlay hidden" id="hint-overlay" role="dialog" aria-modal="true" aria-label="Pista del pedido">
      <div>
        <small>Pista rápida</small>
        <h2>Este era tu pedido</h2>
        <div class="order-list" id="hint-list"></div>
        <p>Memorízalo: desaparecerá en 3 segundos.</p>
      </div>
    </div>

    <style is:global>
      :root { color-scheme: dark; --pink:#f9a8d4; --purple:#a855f7; --deep:#581c87; --gold:#fcd34d; --cream:#fff7ed; }
      * { box-sizing: border-box; }
      body {
        margin: 0; min-height: 100vh; overflow-x: hidden; color: var(--cream);
        font-family: 'Inter', sans-serif;
        background:
          radial-gradient(circle at 15% 10%, rgba(244,114,182,.2), transparent 32%),
          radial-gradient(circle at 85% 90%, rgba(168,85,247,.25), transparent 38%),
          linear-gradient(145deg,#1d0d24,#41164d 52%,#21102a);
      }
      button { font: inherit; }
      .hidden { display: none !important; }
      .ambient { position:fixed; inset:0; overflow:hidden; pointer-events:none; }
      .ambient i {
        position:absolute; left:var(--x); bottom:-15px; width:6px; height:6px; border-radius:50%;
        background:rgba(251,207,232,.7); box-shadow:0 0 14px #f472b6;
        animation:rise var(--t) linear var(--d) infinite;
      }
      @keyframes rise { from{transform:translateY(0);opacity:0} 12%{opacity:.75} to{transform:translateY(-110vh) scale(1.8);opacity:0} }
      main { min-height:100vh; display:grid; place-items:center; padding:24px 14px; position:relative; z-index:1; }
      .shell {
        width:min(900px,100%); padding:clamp(20px,4vw,42px); overflow:hidden; border-radius:28px;
        border:1px solid rgba(251,207,232,.27);
        background:linear-gradient(145deg,rgba(69,27,80,.95),rgba(28,12,35,.96));
        box-shadow:0 35px 90px rgba(0,0,0,.48),inset 0 1px rgba(255,255,255,.09);
      }
      .screen { display:none; text-align:center; }
      .screen.active { display:block; animation:enter .5s cubic-bezier(.2,.8,.2,1); }
      @keyframes enter { from{opacity:0;transform:translateY(17px) scale(.985)} }
      .badge {
        display:inline-flex; padding:7px 16px; border:1px dashed rgba(251,207,232,.48); border-radius:999px;
        color:var(--pink); font:600 10px 'Cinzel',serif; letter-spacing:.22em; text-transform:uppercase;
      }
      h1 {
        margin:17px 0 10px; font:700 clamp(29px,6vw,47px)/1.12 'Cinzel',serif;
        background:linear-gradient(110deg,#fff7ed,#f9a8d4 45%,#c084fc 80%,#fff7ed);
        background-size:240% auto; background-clip:text; color:transparent; animation:shine 5s linear infinite;
      }
      @keyframes shine { to{background-position:240% center} }
      .lead { max-width:630px; margin:0 auto 19px; color:rgba(255,247,237,.84); font:italic 500 clamp(17px,3vw,21px)/1.5 'Cormorant Garamond',serif; }
      .hero-bowl,.final-bowl { width:260px; height:210px; margin:2px auto 15px; position:relative; }
      .hero-cup,.final-cup {
        position:absolute; left:24px; bottom:10px; width:212px; height:118px; display:flex; flex-direction:column;
        align-items:center; justify-content:center; border-radius:18px 18px 105px 105px; color:#7e22ce;
        background:linear-gradient(145deg,#fffaf2,#f5d0fe);
        box-shadow:0 20px 30px rgba(0,0,0,.32),inset 0 -18px 24px rgba(168,85,247,.14);
      }
      .hero-cup span,.final-cup b { font:700 21px 'Cinzel',serif; }
      .hero-cup small,.final-cup small { margin-top:4px; font-size:9px; letter-spacing:.17em; text-transform:uppercase; }
      .hero-base,.final-base {
        position:absolute; z-index:2; left:30px; top:59px; width:200px; height:57px; border:6px solid #fff7ed;
        border-radius:50%; background:radial-gradient(circle at 40% 30%,#a855f7,#581c87 70%);
      }
      .hero-toppings,.final-toppings {
        position:absolute; z-index:4; top:32px; left:15px; width:230px; font-size:34px; letter-spacing:-7px;
        filter:drop-shadow(0 5px 6px rgba(0,0,0,.3)); animation:toppings .8s cubic-bezier(.2,1.4,.4,1);
      }
      @keyframes toppings { from{transform:translateY(-70px) scale(.5);opacity:0} }
      .stages { display:flex; justify-content:center; gap:10px; flex-wrap:wrap; margin:8px 0 24px; }
      .stages div { min-width:145px; padding:10px 13px; display:grid; grid-template-columns:30px 1fr; text-align:left; border:1px solid rgba(251,207,232,.18); border-radius:14px; background:rgba(255,255,255,.04); }
      .stages b { grid-row:1/3; align-self:center; color:var(--gold); font:700 19px 'Cinzel',serif; }
      .stages span { font-weight:600; font-size:12px; }
      .stages small { color:rgba(255,247,237,.55); font-size:9px; }
      .primary,.secondary {
        border-radius:999px; cursor:pointer; font:700 13px 'Cinzel',serif; letter-spacing:.04em; transition:.2s;
      }
      .primary { padding:15px 29px; border:0; color:#35103c; background:linear-gradient(135deg,#fce7f3,#f9a8d4); box-shadow:0 14px 35px -12px rgba(244,114,182,.8); }
      .secondary { padding:11px 20px; color:var(--pink); border:1px solid rgba(251,207,232,.3); background:rgba(255,255,255,.04); }
      .primary:hover,.secondary:hover { transform:translateY(-2px); }
      .timer-ring {
        width:112px; height:112px; margin:18px auto; display:grid; place-content:center; border-radius:50%;
        border:5px solid rgba(249,168,212,.2); box-shadow:0 0 0 7px rgba(168,85,247,.08),inset 0 0 30px rgba(168,85,247,.18);
      }
      .timer-ring strong { color:var(--gold); font:700 38px 'Cinzel',serif; line-height:1; }
      .timer-ring span { margin-top:4px; color:rgba(255,247,237,.55); font-size:9px; letter-spacing:.13em; text-transform:uppercase; }
      .order-card { max-width:660px; margin:0 auto 19px; padding:17px; border:1px solid rgba(252,211,77,.28); border-radius:19px; background:rgba(252,211,77,.055); }
      .order-card p { margin:0 0 12px; color:var(--gold); font:600 11px 'Cinzel',serif; letter-spacing:.12em; text-transform:uppercase; }
      .order-list { display:flex; justify-content:center; gap:9px; flex-wrap:wrap; }
      .order-chip { min-width:72px; padding:8px 7px; border:1px solid rgba(251,207,232,.2); border-radius:12px; background:rgba(255,255,255,.045); }
      .order-chip b { display:block; font-size:27px; }
      .order-chip span { font-size:9px; color:rgba(255,247,237,.72); }
      .hud { display:grid; grid-template-columns:1fr auto 1fr; align-items:end; gap:10px; text-align:left; }
      .hud div:last-child { text-align:right; }
      .hud span { display:block; margin-bottom:4px; color:rgba(251,207,232,.65); font-size:9px; letter-spacing:.18em; text-transform:uppercase; }
      .hud strong { font:600 15px 'Cinzel',serif; color:#fce7f3; }
      .hud-title { color:var(--pink); font:600 clamp(14px,3vw,19px) 'Cinzel',serif; text-transform:uppercase; letter-spacing:.1em; }
      .progress { height:7px; margin:11px 0 15px; overflow:hidden; border-radius:999px; background:rgba(255,255,255,.08); }
      .progress i { display:block; width:0; height:100%; border-radius:inherit; background:linear-gradient(90deg,var(--pink),var(--purple),var(--gold)); transition:width .4s; }
      .challenge-note { display:flex; align-items:center; gap:12px; margin-bottom:15px; padding:11px 14px; text-align:left; border:1px solid rgba(251,207,232,.17); border-radius:15px; background:rgba(255,255,255,.035); }
      .challenge-note>span { font-size:25px; }
      .challenge-note p { flex:1; margin:0; color:rgba(255,247,237,.68); font-size:11px; line-height:1.45; }
      .challenge-note p b { color:#fce7f3; font-size:12px; }
      .challenge-note button { padding:8px 11px; white-space:nowrap; cursor:pointer; color:var(--gold); border:1px solid rgba(252,211,77,.3); border-radius:999px; background:rgba(252,211,77,.07); font-size:10px; }
      .build-grid { display:grid; grid-template-columns:minmax(260px,.88fr) minmax(320px,1.12fr); gap:15px; }
      .bowl-zone {
        min-height:340px; padding:35px 12px 25px; position:relative; overflow:hidden; display:flex; flex-direction:column;
        align-items:center; justify-content:flex-end; border:2px dashed rgba(251,207,232,.29); border-radius:22px;
        background:radial-gradient(circle at 50% 68%,rgba(168,85,247,.18),transparent 43%),rgba(255,255,255,.025); transition:.2s;
      }
      .bowl-zone.over { transform:scale(1.012); border-color:var(--gold); background:rgba(252,211,77,.07); }
      .bowl-zone.wrong { animation:shake .42s; border-color:#fb7185; }
      @keyframes shake { 25%{transform:translateX(-7px)}50%{transform:translateX(7px)}75%{transform:translateX(-4px)} }
      .drop-label { position:absolute; top:15px; color:rgba(251,207,232,.55); font-size:9px; letter-spacing:.2em; text-transform:uppercase; }
      .bowl { z-index:3; width:210px; height:116px; display:flex; flex-direction:column; align-items:center; justify-content:center; border-radius:18px 18px 105px 105px; color:#7e22ce; background:linear-gradient(145deg,#fffaf2,#f5d0fe); box-shadow:inset 0 -18px 24px rgba(168,85,247,.14),0 18px 25px rgba(0,0,0,.28); }
      .bowl b { font-size:29px; }.bowl span { margin-top:3px; font:700 13px 'Cinzel',serif; letter-spacing:.17em; }
      .bowl-rim { z-index:5; width:222px; height:35px; margin-bottom:-18px; border:5px solid #fff7ed; border-radius:50%; background:#581c87; box-shadow:inset 0 0 0 4px rgba(249,168,212,.24); }
      .shadow { width:180px; height:17px; margin-top:-7px; border-radius:50%; background:rgba(0,0,0,.26); filter:blur(5px); }
      .bowl-stack { position:absolute; z-index:4; bottom:134px; width:195px; height:85px; pointer-events:none; }
      .layer { position:absolute; bottom:13px; font-size:32px; filter:drop-shadow(0 4px 5px rgba(0,0,0,.25)); animation:drop .55s cubic-bezier(.2,1.35,.35,1); }
      @keyframes drop { from{opacity:0;transform:translateY(-80px) scale(.5) rotate(-20deg)} }
      .pantry { padding:14px; border:1px solid rgba(251,207,232,.16); border-radius:22px; background:rgba(255,255,255,.025); }
      .pantry>p { margin:0 0 11px; color:rgba(255,247,237,.55); font-size:9px; letter-spacing:.2em; text-transform:uppercase; }
      .ingredients { display:grid; grid-template-columns:repeat(3,1fr); gap:9px; }
      .ingredient {
        min-height:88px; padding:8px 5px; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:5px;
        touch-action:none; user-select:none; cursor:grab; color:rgba(255,247,237,.8); border:1px solid rgba(251,207,232,.17);
        border-radius:14px; background:linear-gradient(145deg,rgba(255,255,255,.065),rgba(255,255,255,.02)); transition:.18s;
      }
      .ingredient:hover,.ingredient:focus-visible { transform:translateY(-3px); border-color:var(--pink); outline:none; background:rgba(249,168,212,.09); }
      .ingredient.used { opacity:.18; filter:grayscale(1); pointer-events:none; }
      .ingredient b { font-size:29px; }.ingredient span { font-size:9px; font-weight:600; line-height:1.2; }
      .feedback { min-height:23px; margin:12px 0 0; color:rgba(255,247,237,.67); font:italic 500 15px 'Cormorant Garamond',serif; }
      .feedback.good { color:#86efac; }.feedback.bad { color:#fda4af; }
      .ghost { position:fixed; z-index:999; width:76px; height:76px; display:grid; place-items:center; pointer-events:none; transform:translate(-50%,-50%) rotate(6deg); border:2px solid var(--pink); border-radius:19px; background:rgba(58,21,69,.96); box-shadow:0 15px 35px rgba(0,0,0,.45); font-size:38px; }
      .drizzle-preview { width:260px; height:230px; margin:4px auto; position:relative; }
      .mini-cup { position:absolute; left:25px; bottom:12px; width:210px; height:120px; display:grid; place-items:center; border-radius:18px 18px 105px 105px; color:#7e22ce; background:linear-gradient(145deg,#fffaf2,#f5d0fe); box-shadow:0 20px 30px rgba(0,0,0,.3); font:700 18px 'Cinzel',serif; }
      .mini-base { position:absolute; z-index:2; left:31px; top:62px; width:198px; height:58px; border:6px solid #fff7ed; border-radius:50%; background:radial-gradient(circle at 40% 30%,#a855f7,#581c87 70%); }
      .mini-toppings { position:absolute; z-index:3; top:35px; width:100%; font-size:31px; letter-spacing:-7px; }
      .sauce { position:absolute; z-index:4; top:56px; left:48px; width:165px; height:55px; opacity:0; border-top:7px dotted var(--gold); border-radius:50%; transform:rotate(-4deg); }
      .sauce.show { opacity:1; animation:sauce .6s ease; } @keyframes sauce{from{clip-path:inset(0 100% 0 0)}}
      .precision { max-width:600px; margin:10px auto 12px; padding:14px; border:1px solid rgba(251,207,232,.17); border-radius:17px; background:rgba(255,255,255,.035); }
      .precision-label { display:block; margin-bottom:10px; color:rgba(255,247,237,.6); font-size:9px; letter-spacing:.2em; text-transform:uppercase; }
      .meter { position:relative; height:20px; border-radius:999px; background:linear-gradient(90deg,#fb7185,#fbbf24,#86efac,#fbbf24,#fb7185); box-shadow:inset 0 2px 5px rgba(0,0,0,.25); }
      .sweet-zone { position:absolute; left:42%; width:16%; height:100%; border:2px solid #fff; border-radius:999px; box-shadow:0 0 15px rgba(255,255,255,.8); }
      .meter i { position:absolute; left:0; top:-8px; width:7px; height:36px; border-radius:99px; background:#fff; box-shadow:0 0 12px #fff; transform:translateX(-50%); }
      .meter-words { display:flex; justify-content:space-between; margin-top:7px; color:rgba(255,247,237,.45); font-size:9px; }.meter-words b{color:#86efac}
      .final-drizzle { position:absolute; z-index:5; top:61px; left:48px; color:var(--gold); font-size:18px; transform:rotate(-5deg); }
      .prize { max-width:590px; margin:8px auto 13px; padding:19px; border:1px solid rgba(252,211,77,.34); border-radius:20px; background:radial-gradient(circle at 50% 0,rgba(252,211,77,.13),transparent 60%),rgba(255,255,255,.04); }
      .prize>span { font-size:35px; }.prize small { display:block; margin:5px 0 3px; color:var(--gold); font-size:9px; letter-spacing:.22em; text-transform:uppercase; }
      .prize h2 { margin:0; color:#fce7f3; font:700 clamp(23px,5vw,32px) 'Cinzel',serif; }.prize p { margin:7px 0 0; font:italic 600 20px 'Cormorant Garamond',serif; }
      .closing { max-width:580px; margin:13px auto; color:rgba(255,247,237,.72); font:italic 500 17px/1.5 'Cormorant Garamond',serif; }
      .signature { display:flex; justify-content:center; align-items:center; gap:12px; margin:13px 0; }.signature i{width:55px;height:1px;background:linear-gradient(90deg,transparent,var(--pink),transparent)}.signature em{color:var(--pink);font:italic 600 21px 'Cormorant Garamond',serif}
      .hint-overlay { position:fixed; z-index:1000; inset:0; display:grid; place-items:center; padding:20px; background:rgba(15,5,20,.82); backdrop-filter:blur(8px); }
      .hint-overlay>div { width:min(650px,100%); padding:25px; text-align:center; border:1px solid rgba(252,211,77,.35); border-radius:22px; background:linear-gradient(145deg,#482052,#25102e); box-shadow:0 30px 80px rgba(0,0,0,.5); }
      .hint-overlay small { color:var(--gold); letter-spacing:.2em; text-transform:uppercase; }.hint-overlay h2{margin:8px 0 15px;font:700 25px 'Cinzel',serif}.hint-overlay p{margin:14px 0 0;color:rgba(255,247,237,.6);font-size:11px}
      .confetti-piece { position:absolute; z-index:9; top:-20px; width:8px; height:14px; pointer-events:none; animation:confetti var(--t) ease-in var(--d) forwards; }
      @keyframes confetti { to{transform:translate(var(--x),800px) rotate(720deg);opacity:.1} }
      @media(max-width:720px){.shell{padding:20px 13px;border-radius:21px}.build-grid{grid-template-columns:1fr}.bowl-zone{min-height:285px}.ingredients{grid-template-columns:repeat(3,1fr)}.ingredient{min-height:72px}.ingredient b{font-size:25px}.hud-title{display:none}}
      @media(max-width:460px){.ingredients{grid-template-columns:repeat(3,1fr)}.challenge-note{align-items:flex-start;flex-wrap:wrap}.challenge-note p{min-width:200px}.challenge-note button{margin-left:auto}.stages div{width:100%}.order-chip{min-width:65px}.hud strong{font-size:12px}}
      @media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important}}
    </style>

    <script>
      type Topping = { id:string; name:string; emoji:string };

      // Toppings reales del lugar de açaí que conoce Mariela.
      const all: Topping[] = [
        {id:'milk-powder',name:'Leche en polvo',emoji:'🥛'},
        {id:'cofler',name:'Chocolate Cofler',emoji:'🍫'},
        {id:'chubis',name:'Chubis',emoji:'🌈'},
        {id:'gummies',name:'Gomitas',emoji:'🍬'},
        {id:'candied-peanut',name:'Maní confitado',emoji:'🥜'},
        {id:'oats',name:'Avena',emoji:'🌾'},
        {id:'almond',name:'Almendra',emoji:'🌰'},
        {id:'shredded-coconut',name:'Coco rallado',emoji:'🥥'},
        {id:'peach',name:'Durazno',emoji:'🍑'}
      ];

      const screens = {
        welcome:document.getElementById('welcome')!, memory:document.getElementById('memory')!,
        build:document.getElementById('build')!, drizzle:document.getElementById('drizzle')!,
        result:document.getElementById('result')!
      };
      const bowlZone = document.getElementById('bowl-zone')!;
      const feedback = document.getElementById('feedback')!;
      let order:Topping[] = [], found = new Set<string>(), lives=3, hints=2, timer=0;
      let countdownInterval=0, ghost:HTMLElement|null=null, dragging:Topping|null=null, moved=false, suppressClick=false;
      let markerPos=0, markerStart=0, markerRaf=0, precisionTries=3;

      function shuffle<T>(items:T[]) { return [...items].sort(()=>Math.random()-.5); }
      function show(name:keyof typeof screens) {
        Object.values(screens).forEach(s=>s.classList.remove('active')); screens[name].classList.add('active');
        window.scrollTo({top:0,behavior:'smooth'});
      }
      function chips(items:Topping[]) {
        return items.map(t=>`<div class="order-chip"><b>${t.emoji}</b><span>${t.name}</span></div>`).join('');
      }
      function newGame() {
        order=shuffle(all).slice(0,7); found.clear(); lives=3; hints=2; precisionTries=3;
        document.getElementById('bowl-stack')!.innerHTML='';
        document.getElementById('sauce')!.classList.remove('show');
        document.getElementById('hint-count')!.textContent='2';
        document.getElementById('memory-list')!.innerHTML=chips(order);
        document.getElementById('hint-list')!.innerHTML=chips(order);
        updateHud(); renderPantry(); startMemory();
      }
      function startMemory() {
        show('memory'); let seconds=6; document.getElementById('countdown')!.textContent=String(seconds);
        clearInterval(countdownInterval);
        countdownInterval=window.setInterval(()=>{
          seconds--; document.getElementById('countdown')!.textContent=String(Math.max(0,seconds));
          if(seconds<=0) beginBuild();
        },1000);
      }
      function beginBuild() {
        clearInterval(countdownInterval); show('build');
        feedback.className='feedback'; feedback.textContent='Recuerda el pedido y elige con cuidado.';
      }
      function renderPantry() {
        const el=document.getElementById('ingredients')!;
        el.innerHTML=shuffle(all).map(t=>`<button class="ingredient" data-id="${t.id}" type="button" aria-label="Agregar ${t.name}"><b>${t.emoji}</b><span>${t.name}</span></button>`).join('');
        el.querySelectorAll<HTMLButtonElement>('.ingredient').forEach(btn=>{
          const item=all.find(t=>t.id===btn.dataset.id)!;
          btn.addEventListener('pointerdown',e=>startDrag(e,item));
          btn.addEventListener('click',()=>{ if(suppressClick){suppressClick=false;return} choose(item); });
        });
      }
      function updateHud() {
        document.getElementById('found')!.textContent=`${found.size} / ${order.length}`;
        document.getElementById('hearts')!.textContent='💜 '.repeat(lives)+'♡ '.repeat(3-lives);
        document.getElementById('progress')!.style.width=`${found.size/order.length*100}%`;
      }
      function choose(item:Topping) {
        if(found.has(item.id)) return;
        const correct=order.some(t=>t.id===item.id);
        if(!correct){
          lives--; feedback.className='feedback bad'; feedback.textContent=`${item.emoji} no estaba en el pedido. ¡Inténtalo otra vez!`;
          bowlZone.classList.remove('wrong'); void bowlZone.clientWidth; bowlZone.classList.add('wrong');
          setTimeout(()=>bowlZone.classList.remove('wrong'),450);
          if(lives<=0){ lives=3; revealHint('Te devolví tus intentos. Mira bien la receta.'); }
          updateHud(); return;
        }
        found.add(item.id);
        document.querySelector<HTMLElement>(`.ingredient[data-id="${item.id}"]`)?.classList.add('used');
        addTopping(item,found.size-1);
        feedback.className='feedback good'; feedback.textContent=`¡Sí! ${item.name} era parte del pedido ${item.emoji}`;
        updateHud();
        if(found.size===order.length) setTimeout(beginDrizzle,750);
      }
      function addTopping(item:Topping,index:number) {
        const el=document.createElement('span'); el.className='layer'; el.textContent=item.emoji;
        const x=[4,29,55,80,108,134,158]; el.style.left=`${x[index]}px`; el.style.transform=`rotate(${index%2?8:-8}deg)`;
        document.getElementById('bowl-stack')!.appendChild(el);
      }
      function revealHint(message='') {
        const overlay=document.getElementById('hint-overlay')!; overlay.classList.remove('hidden');
        if(message) overlay.querySelector('p')!.textContent=message;
        setTimeout(()=>overlay.classList.add('hidden'),3000);
      }
      function beginDrizzle() {
        show('drizzle');
        const emojis=order.map(t=>t.emoji).join(' ');
        document.getElementById('mini-toppings')!.textContent=emojis;
        document.getElementById('final-toppings')!.textContent=emojis;
        startMarker();
      }
      function startMarker() {
        markerStart=performance.now(); cancelAnimationFrame(markerRaf);
        const tick=(now:number)=>{
          const phase=((now-markerStart)%1800)/1800;
          markerPos=phase<.5?phase*200:(1-phase)*200;
          document.getElementById('marker')!.style.left=`${markerPos}%`;
          markerRaf=requestAnimationFrame(tick);
        }; markerRaf=requestAnimationFrame(tick);
      }
      function stopMarker() {
        const perfect=markerPos>=42&&markerPos<=58;
        if(perfect){
          cancelAnimationFrame(markerRaf); document.getElementById('sauce')!.classList.add('show');
          document.getElementById('precision-feedback')!.className='feedback good';
          document.getElementById('precision-feedback')!.textContent='¡Perfecto! Justo en el centro ✨';
          setTimeout(finish,900); return;
        }
        precisionTries--;
        document.getElementById('precision-feedback')!.className='feedback bad';
        document.getElementById('precision-feedback')!.textContent=precisionTries>0?`¡Casi! Te quedan ${precisionTries} intentos.`:'¡Muy cerca! El bowl igual quedó delicioso.';
        if(precisionTries<=0){ cancelAnimationFrame(markerRaf); document.getElementById('sauce')!.classList.add('show'); setTimeout(finish,900); }
      }
      function finish() {
        localStorage.setItem('mariela_acai_completed','true'); show('result'); confetti();
      }
      function confetti() {
        const host=document.getElementById('confetti')!; host.innerHTML='';
        const colors=['#f9a8d4','#c084fc','#fcd34d','#86efac','#fff7ed'];
        for(let i=0;i<48;i++){const p=document.createElement('i');p.className='confetti-piece';p.style.left=`${Math.random()*100}%`;p.style.background=colors[i%colors.length];p.style.setProperty('--t',`${2.6+Math.random()*2}s`);p.style.setProperty('--d',`${Math.random()}s`);p.style.setProperty('--x',`${-80+Math.random()*160}px`);host.appendChild(p)}
      }
      function startDrag(e:PointerEvent,item:Topping) {
        e.preventDefault(); dragging=item; moved=false; ghost=document.createElement('div');ghost.className='ghost';ghost.textContent=item.emoji;document.body.appendChild(ghost);moveGhost(e.clientX,e.clientY);
        window.addEventListener('pointermove',dragMove);window.addEventListener('pointerup',endDrag,{once:true});window.addEventListener('pointercancel',endDrag,{once:true});
      }
      function moveGhost(x:number,y:number){if(ghost){ghost.style.left=`${x}px`;ghost.style.top=`${y}px`}}
      function inside(x:number,y:number){const r=bowlZone.getBoundingClientRect();return x>=r.left&&x<=r.right&&y>=r.top&&y<=r.bottom}
      function dragMove(e:PointerEvent){moved=true;moveGhost(e.clientX,e.clientY);bowlZone.classList.toggle('over',inside(e.clientX,e.clientY))}
      function endDrag(e:PointerEvent){
        window.removeEventListener('pointermove',dragMove);const dropped=inside(e.clientX,e.clientY);ghost?.remove();ghost=null;bowlZone.classList.remove('over');
        if(dropped&&dragging){suppressClick=true;choose(dragging)} dragging=null;setTimeout(()=>{moved=false},0);
      }

      document.getElementById('start')!.addEventListener('click',newGame);
      document.getElementById('skip-memory')!.addEventListener('click',beginBuild);
      document.getElementById('hint')!.addEventListener('click',()=>{if(hints<=0)return;hints--;document.getElementById('hint-count')!.textContent=String(hints);revealHint()});
      document.getElementById('pour')!.addEventListener('click',stopMarker);
      document.getElementById('again')!.addEventListener('click',newGame);
    </script>
  </body>
</html>
